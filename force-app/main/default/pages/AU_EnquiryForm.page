  var scPhoneLink = document.getElementById('successPhoneLink');
  var scPhoneText = document.getElementById('successPhoneText');
  if (scPhoneLink && scPhoneText) {
    scPhoneText.textContent = phone;
    scPhoneLink.href = 'tel:' + phone.replace(/[^0-9+]/g, '');
