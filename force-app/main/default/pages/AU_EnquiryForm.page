  // 3. Step 2 (Form card) Department Contact Bar
  var formTitle = document.getElementById('formContactTitle');
  if (formTitle) formTitle.textContent = title;

  var formPhone = document.getElementById('formContactPhone');
  var formPhoneText = document.getElementById('formContactPhoneText');
  if (formPhone) {
    formPhone.href = 'tel:' + phone.replace(/[^0-9+]/g, '');
    if (formPhoneText) formPhoneText.textContent = phone;
    else formPhone.textContent = phone;
  }

  var formEmail = document.getElementById('formContactEmail');
  var formEmailText = document.getElementById('formContactEmailText');
  if (formEmail) {
    formEmail.href = 'mailto:' + email;
    if (formEmailText) formEmailText.textContent = email;
    else formEmail.textContent = email;
  }

  // 4. Step 2 Sub-note (under submit button)
  var subDept = document.getElementById('formSubNoteDept');
  if (subDept) subDept.textContent = title;
  var subPhone = document.getElementById('subNotePhone');
  if (subPhone) {
    subPhone.textContent = phone;
    subPhone.href = 'tel:' + phone.replace(/[^0-9+]/g, '');
  }
  var subEmail = document.getElementById('subNoteEmail');
  if (subEmail) {
    subEmail.textContent = email;
    subEmail.href = 'mailto:' + email;
  }

  // 5. Success panel contact card (Step 3)
  var scTitle = document.getElementById('successContactTitle');
