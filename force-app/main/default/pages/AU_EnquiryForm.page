/* ── XSS helper ──────────────────────────────────────────────── */
function esc(s) {
  return String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ── Slug maps from metadata ────────────────────────────────────
   FORM_SLUGS  maps slug → canonical slug (e.g. 'wonderchat' → 'wonderchat')
   A form slug is shared across multiple Form_Config records (one per dept).
   e.g. wonderchat_masters, wonderchat_ug, wonderchat_phd, wonderchat_exec_ed
   all share the same Form_Slug__c = 'wonderchat'.
   We match by slug, not by DeveloperName/code.
────────────────────────────────────────────────────────────── */
function buildSlugMaps(metaArray) {
  var dSlugs = {};
  var fSlugs = {};  // formSlug → formSlug (normalise casing only)
  metaArray.forEach(function(d) {
    (d.slugs || []).forEach(function(s) { dSlugs[s.toLowerCase()] = d.code; });
    (d.forms || []).forEach(function(f) {
      var slug = (f.slug || f.code).toLowerCase();
      fSlugs[slug] = slug;  // maps slug to itself (lowercased)
      fSlugs[f.code.toLowerCase()] = f.code.toLowerCase();
    });
  });
  return { dept: dSlugs, form: fSlugs };
}
function resolveDeptSlug(raw) {
  if (!raw) return '';
  var lower = raw.toLowerCase().trim();
  return DEPT_SLUGS[lower] || raw.toUpperCase();
}
/* Returns the raw form slug (lowercased) — e.g. 'wonderchat' */
function resolveFormSlug(raw) {
  if (!raw) return '';
  var lower = raw.toLowerCase().trim();
  return FORM_SLUGS[lower] || lower;
}
/* Find all form objects across all depts that match a given slug.
   Returns array of { form, dept } pairs. */
function findFormsBySlug(formSlug) {
  var results = [];
  var slug = (formSlug || '').toLowerCase().trim();
  META.forEach(function(d) {
    (d.forms || []).forEach(function(f) {
      var fslug = (f.slug || f.code).toLowerCase();
      if (fslug === slug) {
        results.push({ form: f, dept: d });
      }
    });
  });
  return results;
}
/* Find a single form by exact code (DeveloperName) — used for specific lookup */
function findFormByCode(formCode) {
  var found = null;
  META.forEach(function(d) {
    (d.forms || []).forEach(function(f) {
      if (f.code === formCode) { found = f; activeDept = d; }
    });
  });
  return found;
}

/* ── Render dept tiles ───────────────────────────────────────── */
/* Render all dept tiles (no filter) */
function renderDeptTiles() { renderFilteredDeptTiles(null); }
function renderTiles()     { renderFilteredDeptTiles(null); }

/* Render dept tiles filtered to a subset of codes.
   filteredCodes = null → show all depts
   filteredCodes = ['MASTERS','UG'] → only those depts (?form= mode) */
function renderFilteredDeptTiles(filteredCodes) {
  var grid = document.getElementById('deptGrid');
  grid.innerHTML = '';
  if (!META.length) {
    document.getElementById('metaLoading').style.display = 'none';
    document.getElementById('metaError').style.display  = 'block';
    return;
  }
  document.getElementById('metaLoading').style.display = 'none';

  var show = filteredCodes
    ? META.filter(function(d) { return filteredCodes.indexOf(d.code) !== -1; })
    : META;

  if (!show.length) {
    document.getElementById('metaError').style.display = 'block';
    document.getElementById('metaError').innerHTML =
      'No departments available. Please check Form_Department_Config records.';
    return;
  }

  show.forEach(function(d) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dept-tile';
    btn.setAttribute('data-code', d.code);
    btn.innerHTML =
      '<span class="d-icon">' + d.icon + '</span>' +
      '<span class="d-name">' + esc(d.name) + '</span>' +
      '<span class="d-sub">'  + esc(d.subtitle || '') + '</span>';
    btn.addEventListener('click', function() { selectDept(d.code); });
    grid.appendChild(btn);
  });
}

/* ── Select dept → always go directly to form (step 2) ─────────
   The "Select Form" intermediate step is removed.
   - 1 form:  go straight to it
   - Many forms: use the first form as default (staff can use
     ?form=slug to route to a specific form)
────────────────────────────────────────────────────────────── */
function selectDept(code) {
  activeDept = null;
  META.forEach(function(d) { if (d.code === code) activeDept = d; });
  if (!activeDept) return;

  updateContactInfo(activeDept);

  document.querySelectorAll('#deptGrid .dept-tile').forEach(function(t) {
    t.classList.toggle('sel', t.getAttribute('data-code') === code);
  });
  document.getElementById('hDept').value     = activeDept.name;
  document.getElementById('hDeptCode').value = activeDept.code;
  document.getElementById('deptPill').textContent = activeDept.name;
  document.getElementById('deptPill').classList.add('show');

  var forms = activeDept.forms || [];

  if (forms.length === 0) {
    console.error('AU Form: dept "' + code + '" has no forms. Check Form_Field_Config records.');
    document.getElementById('metaError').style.display = 'block';
    document.getElementById('metaError').innerHTML =
      'No fields configured for <strong>' + esc(activeDept.name) + '</strong>. ' +
      'Please add Form_Field_Config__mdt records in Salesforce.';
    return;
  }

  /* If a specific form was requested via ?form=slug, find the matching
     Form_Config record for THIS dept by matching the slug field.
     e.g. _urlFormCode='wonderchat', dept=MASTERS → find form with slug='wonderchat'
     in MASTERS.forms[]. Fall back to forms[0] if not found. */
  var requestedSlug = (window._urlFormCode || '').toLowerCase();
  var formToOpen    = null;
  if (requestedSlug) {
    forms.forEach(function(f) {
      var fslug = (f.slug || '').toLowerCase();
      if (fslug === requestedSlug) formToOpen = f;
    });
  }
  selectForm(formToOpen ? formToOpen.code : forms[0].code);
}

/* ── Select form → build dynamic fields → go to step 2 ──────── */
function selectForm(fCode) {
  activeForm = null;
  (activeDept.forms || []).forEach(function(f) {
    if (f.code === fCode) activeForm = f;
  });
  if (!activeForm) return;

  document.getElementById('hFormCode').value = activeForm.code;
  /* Show dept name on pill — form name only if meaningfully different from dept */
  document.getElementById('deptPill').textContent = activeDept.name;

  buildDynFields(activeForm);
  setTimeout(function() { showStep(2); }, 200);
}

/* ── Build dynamic fields from form metadata ─────────────────── */
function buildDynFields(formObj) {
  var container = document.getElementById('dynFields');
  container.innerHTML = '';
  document.getElementById('dynLabel').textContent = 'Programme Details';

  var hasVisible = false;

  (formObj.fields || []).forEach(function(f) {
    if (f.isHidden) {
      var hInput = document.createElement('input');
      hInput.type = 'hidden';
      hInput.name = f.sfApiName;
      hInput.value = f.defaultValue || '';
      container.appendChild(hInput);
      return;
    }

    hasVisible = true;
    var wrap = document.createElement('div');
    wrap.className = 'fgrp' + (f.fullWidth ? ' sp2' : '');

    var lbl = document.createElement('label');
    lbl.innerHTML = esc(f.label) + (f.required ? ' <span class="req">*</span>' : '');
    wrap.appendChild(lbl);

    var el;
    if (f.type === 'programme_picklist' || f.type === 'picklist') {
      el = document.createElement('select');
      el.name = f.sfApiName;
      var dOpt = document.createElement('option');
      dOpt.value = '';
      dOpt.textContent = f.type === 'programme_picklist' ? 'Select Programme…' : 'Select…';
      el.appendChild(dOpt);
      var list = f.type === 'programme_picklist'
        ? (formObj.programmes || f.options || []) : (f.options || []);
      list.forEach(function(o) {
        var opt = document.createElement('option');
        opt.value = o; opt.textContent = o;
        el.appendChild(opt);
      });
      if (f.defaultValue) {
        el.value = f.defaultValue;
      }
    } else if (f.type === 'textarea') {
      el = document.createElement('textarea');
      el.name = f.sfApiName;
      el.rows = 3;
      el.placeholder = f.placeholder || '';
      el.style.resize = 'vertical';
      if (f.defaultValue) {
        el.value = f.defaultValue;
      }
    } else {
      el = document.createElement('input');
      el.type = ({ number:'number', date:'date', email:'email', tel:'tel' })[f.type] || 'text';
      el.name = f.sfApiName;
      el.placeholder = f.placeholder || '';
      if (f.type === 'number') { el.step = '0.01'; el.min = '0'; }
      if (f.defaultValue) {
        el.value = f.defaultValue;
      }
    }
    if (f.required) el.required = true;
    wrap.appendChild(el);

    var eSpan = document.createElement('span');
    eSpan.className = 'f-err';
    eSpan.id = 'e_' + f.sfApiName;
    eSpan.textContent = 'Please fill in ' + f.label;
    wrap.appendChild(eSpan);

    if (f.hint) {
      var hint = document.createElement('span');
      hint.className = 'f-hint';
      hint.textContent = f.hint;
      wrap.appendChild(hint);
    }
    container.appendChild(wrap);
  });

  document.getElementById('dynWrap').style.display = hasVisible ? 'block' : 'none';
}

/* ── Step navigation (3 steps) ──────────────────────────────── */
function showStep(n) {
  /* n=1: dept tiles  n=2: enquiry form  n=3: thank you */
  document.getElementById('step1').style.display = n === 1 ? 'block' : 'none';
  document.getElementById('step2').style.display = n === 2 ? 'block' : 'none';
  document.getElementById('successPanel').classList.toggle('show', n === 3);

  ['s1','s2','s3'].forEach(function(id, i) {
    var el = document.getElementById(id);
    if (!el) return;
    el.className = 'step' + (i+1===n ? ' active' : i+1<n ? ' done' : '');
  });
  ['ln1','ln2'].forEach(function(id, i) {
    var el = document.getElementById(id);
    if (!el) return;
    el.className = 'step-line' + (n > i+1 ? ' done' : '');
  });

  var deptName  = activeDept  ? activeDept.name == 'PhD' ? 'Doctoral' : activeDept.name   : '';
  var formName  = activeForm  ? activeForm.name   : '';
  var titles = {
    1: 'Select Your Programme',
    2: deptName ? deptName + ' Enquiry Form' : 'Enquiry Form',
    3: 'Enquiry Confirmed'
  };
  document.getElementById('cardTitle').textContent = titles[n] || '';
}

/* ── Validation ──────────────────────────────────────────────── */
function validateForm() {
  var valid = true;

  /* Required fields */
  document.getElementById('eForm').querySelectorAll('[required]').forEach(function(el) {
    if (el.type === 'checkbox') return;
    var grp = el.closest('.fgrp');
    var eEl = document.getElementById('e_' + el.name)
              || (grp && grp.querySelector('.f-err'));
    var empty = !el.value.trim();
    el.classList.toggle('err', empty);
    if (eEl) eEl.classList.toggle('show', empty);
    if (empty) valid = false;
    el.addEventListener('input', function fix() {
      el.classList.remove('err');
      if (eEl) eEl.classList.remove('show');
      el.removeEventListener('input', fix);
    });
  });

  /* Email format */
  var emailEl = document.getElementById('fEmail');
  if (emailEl && emailEl.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value)) {
    emailEl.classList.add('err');
    var em = document.getElementById('e_Email');
    if (em) { em.textContent = 'Please enter a valid email address'; em.classList.add('show'); }
    valid = false;
  }

  /* phone — digits only; India = exactly 10, other countries 6–14 digits */
  var phoneEl = document.getElementById('fMobile');
  if (phoneEl && phoneEl.value) {
    var phoneOk = phoneDigitsOk();
    phoneEl.classList.toggle('err', !phoneOk);
    var ep = document.getElementById('e_Phone');
    if (ep) ep.classList.toggle('show', !phoneOk);
    if (!phoneOk) valid = false;
    if (!phoneOk) {
      phoneEl.addEventListener('input', function fixPhone() {
        var ok = phoneDigitsOk();
        phoneEl.classList.toggle('err', !ok);
        if (ep) ep.classList.toggle('show', !ok);
        if (ok) phoneEl.removeEventListener('input', fixPhone);
      });
    }
  }

  /* Consent */
  var chk  = document.getElementById('consentChk');
  var echk = document.getElementById('e_consent');
  if (!chk.checked) { echk.classList.add('show'); valid = false; }
  else               { echk.classList.remove('show'); }

  return valid;
}

function phoneDigitsOk() {
  var d = document.getElementById('fMobile').value.replace(/\D/g, '').replace(/^0+/, '');
  var cc = document.getElementById('fPhoneCountry').value;
  return cc === 'IN' ? d.length === 10 : (d.length >= 6 && d.length <= 14);
}

/* ── Collect payload ─────────────────────────────────────────── */
function collectPayload() {
  var payload = {};
  new FormData(document.getElementById('eForm')).forEach(function(val, key) {
    // national digits only; country sent separately as Phone_Country (ISO)
    if (key === 'Phone') {
      val = String(val).replace(/\D/g, '').replace(/^0+/, '');
    }
    if (val && String(val).trim()) payload[key] = String(val).trim();
  });
  return payload;
}

/* ── Back to dept selection (step 2 → step 1) ───────────────── */
/* Department fixed by URL → no "Change Department" button */
function hideBackToDept() {
  var bar = document.querySelector('#step2 .back-bar');
  if (bar) bar.style.display = 'none';
}

function goBackToDept() {
  activeForm = null;
  activeDept = null;
  updateContactInfo(null);
  document.querySelectorAll('#deptGrid .dept-tile').forEach(function(t) {
    t.classList.remove('sel');
  });
  document.getElementById('deptPill').classList.remove('show');
  document.getElementById('dynWrap').style.display = 'none';
  document.getElementById('dynFields').innerHTML   = '';
  document.getElementById('errBanner').classList.remove('show');
  document.getElementById('eForm').querySelectorAll('.err').forEach(function(el) {
    el.classList.remove('err');
  });
  document.getElementById('eForm').querySelectorAll('.f-err.show').forEach(function(el) {
    el.classList.remove('show');
  });
  document.getElementById('e_consent').classList.remove('show');
  /* If form was filtered by URL (e.g. ?form=wonderchat), back button
     should only show the depts for that form, not all depts */
  if (window._filteredDeptCodes && window._filteredDeptCodes.length) {
    renderFilteredDeptTiles(window._filteredDeptCodes);
  }
  showStep(1);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ── Submit ──────────────────────────────────────────────────── */
function handleSubmit() {
  var errBanner  = document.getElementById('errBanner');
  var captchaErr = document.getElementById('captchaErr');
  errBanner.classList.remove('show');
  captchaErr.classList.remove('show');

  /* Step 1: Client-side form validation first */
  if (!validateForm()) {
    var firstErr = document.querySelector('.err');
    if (firstErr) firstErr.scrollIntoView({ behavior:'smooth', block:'center' });
    return;
  }

  var btn     = document.getElementById('submitBtn');
  var btnText = document.getElementById('btnText');
  btn.disabled = true;
  btn.classList.add('loading');
  btnText.textContent = 'Verifying…';

  /* Step 2: Execute reCAPTCHA v3 — get a token invisibly
     The token is sent to the Apex controller for server-side verification.
     Action name 'submit_enquiry' appears in the reCAPTCHA dashboard so you
     can track scores per-action and detect bot patterns over time.        */
  if (typeof grecaptcha === 'undefined') {
    /* reCAPTCHA script failed to load (e.g. ad blocker or network error).
       Degrade gracefully: proceed without score — log for monitoring.    */
    console.warn('AU Form: reCAPTCHA not loaded — proceeding without CAPTCHA check.');
    submitWithToken('');
    return;
  }

  grecaptcha.ready(function() {
    grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: 'submit_enquiry' })
      .then(function(token) {
        submitWithToken(token);
      })
      .catch(function(err) {
        console.error('AU Form: reCAPTCHA execute failed:', err);
        /* On reCAPTCHA API error, degrade gracefully */
        submitWithToken('');
      });
  });
}

/* ── submitWithToken() — called after reCAPTCHA token is obtained ─────
   Sends payload + token to Apex. Apex verifies the token with Google's
   API server-side (score checked in AU_EnquiryFormController.createLead).
─────────────────────────────────────────────────────────────────────── */
function submitWithToken(captchaToken) {
  var errBanner  = document.getElementById('errBanner');
  var captchaErr = document.getElementById('captchaErr');
  var btn        = document.getElementById('submitBtn');
  var btnText    = document.getElementById('btnText');

  btnText.textContent = 'Submitting…';

  /* Add the token to the payload — Apex will verify it with Google */
  var payload = collectPayload();
  payload['captchaToken'] = captchaToken;

  remoteCreateLead(payload, function(result, event) {
    btn.disabled = false;
    btn.classList.remove('loading');
    btnText.textContent = 'Submit Enquiry';

    if (event.status && result && result.success) {
      var bUrl = result.brochureUrl || '';
      var bBox = document.getElementById('brochureBox');
      if (/^https:\/\//i.test(bUrl)) {
        document.getElementById('brochureLink').href = bUrl;
        bBox.style.display = 'block';
      } else {
        bBox.style.display = 'none';
      }
      showStep(3);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (event.status && result && result.captchaFailed) {
      /* Apex returned captchaFailed=true — score too low */
      captchaErr.classList.add('show');
      captchaErr.scrollIntoView({ behavior:'smooth', block:'center' });
    } else {
      var msg = (result && result.error)
              ? result.error
              : (event.message || 'Submission failed. Please try again.');
      errBanner.textContent = '⚠ ' + msg;
      errBanner.classList.add('show');
      errBanner.scrollIntoView({ behavior:'smooth', block:'center' });
    }
  });
}

/* ── Reset ───────────────────────────────────────────────────── */
function resetForm() {
  document.getElementById('eForm').reset();
  document.getElementById('dynWrap').style.display = 'none';
  document.getElementById('dynFields').innerHTML   = '';
  document.getElementById('deptPill').classList.remove('show');
  document.getElementById('errBanner').classList.remove('show');
  document.getElementById('e_consent').classList.remove('show');
  activeDept = null;
  activeForm  = null;
  updateContactInfo(null);
  document.querySelectorAll('.dept-tile').forEach(function(t) {
    t.classList.remove('sel');
  });
  showStep(1);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ── Phone: digits only while typing, India capped at 10 ─────── */
document.addEventListener('DOMContentLoaded', function() {
  var ph = document.getElementById('fMobile');
  var cc = document.getElementById('fPhoneCountry');
  if (!ph || !cc) return;
  function max() { return cc.value === 'IN' ? 10 : 14; }
  function clean(v) {
    var d = v.replace(/\D/g, '');
    // drop a pasted dial code (e.g. +91 98765...) matching the selected country
    var dial = cc.options[cc.selectedIndex].getAttribute('data-dial').replace('+', '');
    if (/^\s*\+/.test(v) && d.indexOf(dial) === 0) d = d.slice(dial.length);
    return d.slice(0, max());
  }
  ph.addEventListener('input', function() { this.value = this.value.replace(/\D/g, '').slice(0, max()); });
  ph.addEventListener('paste', function(e) {
    e.preventDefault();
    this.value = clean((e.clipboardData || window.clipboardData).getData('text'));
  });
  cc.addEventListener('change', function() { ph.value = ph.value.slice(0, max()); });
});

/* ── INIT ────────────────────────────────────────────────────── */
/*
  3-STEP ROUTING LOGIC
  ════════════════════
  ?form=wonderchat&dept=masters
    → Open Masters department form directly (skip step 1)

  ?form=wonderchat  (no dept)
    → Show only the departments that belong to this form (filtered step 1)
    → Student selects a dept → opens that dept's form immediately

  ?dept=masters  (no form)
    → Open Masters with its first/default form directly (skip step 1)

  No params
    → Show all departments (default step 1)
*/
(function init() {
  var url = getURLParams();

  applyEmbedMode(url.embed);
  initUTM(url);
  updateContactInfo(null);
  showStep(1);
  window._filteredDeptCodes = null;  // used by goBackToDept

  remoteGetStatePicklistValues(function(statesResult, statesEvent) {
    if (statesEvent.status && statesResult && statesResult.length > 0) {
      var stateSelect = document.getElementById('fState');
      if (stateSelect) {
        stateSelect.innerHTML = '<option value="">Select State</option>';
        statesResult.forEach(function(stateName) {
          var opt = document.createElement('option');
          opt.value = stateName;
          opt.textContent = stateName;
          stateSelect.appendChild(opt);
        });
      }
    }
  });

  remoteGetMetadata(function(result, event) {

    if (!event.status || !result || !result.length) {
      document.getElementById('metaLoading').style.display = 'none';
      document.getElementById('metaError').style.display  = 'block';
      if (!event.status) {
        console.error('AU Form: getMetadata failed:', event.message, event.type);
      } else {
        console.warn('AU Form: getMetadata returned empty. Check Form_Department_Config__mdt records and Guest User permissions.');
      }
      return;
    }

    META     = result;
    var slugMaps = buildSlugMaps(META);
    DEPT_SLUGS   = slugMaps.dept;
    FORM_SLUGS   = slugMaps.form;

    /* Read URL params */
    var p          = new URLSearchParams(window.location.search);
    var rawDept    = (p.get('dept') || p.get('department') || '').trim();
    var rawForm    = (p.get('form') || '').trim();
    var serverDept = document.getElementById('hServerDept').value || '';
    var serverForm = document.getElementById('hServerForm').value  || '';

    var deptCode = rawDept ? resolveDeptSlug(rawDept) : serverDept;
    var formCode = rawForm ? resolveFormSlug(rawForm) : serverForm;

    /* ── SCENARIO 1: ?form + ?dept → open that specific dept's form directly ─
       e.g. ?form=wonderchat&dept=masters
       Finds the Form_Config record whose slug='wonderchat' AND whose dept='MASTERS'.
       Skips step 1 entirely — goes straight to the enquiry form.                  */
    if (formCode && deptCode) {
      /* Find all form records matching this slug, then pick the one for deptCode */
      var matches = findFormsBySlug(formCode);
      var match   = null;
      matches.forEach(function(m) {
        if (m.dept.code === deptCode) match = m;
      });
      if (match) {
        activeDept = match.dept;
        document.getElementById('hDept').value     = activeDept.name;
        document.getElementById('hDeptCode').value = activeDept.code;
        document.getElementById('deptPill').classList.add('show');
        updateContactInfo(activeDept);
        /* Store slug so selectDept can find the right form */
        window._urlFormCode = formCode;
        hideBackToDept();
        selectForm(match.form.code);
        return;
      }
      /* Slug matched but no record for this specific dept — fall through */
      console.warn('AU Form: no form with slug="' + formCode + '" for dept="' + deptCode + '".');
    }

    /* ── SCENARIO 2: ?form only → filter dept tiles to this form's depts ─────
       e.g. ?form=wonderchat
       Finds ALL Form_Config records with slug='wonderchat', collects their depts,
       and shows ONLY those dept tiles. Student picks a dept → opens that form.   */
    if (formCode && !deptCode) {
      /* Find all dept codes that have a form matching this slug */
      var slugMatches  = findFormsBySlug(formCode);
      var formDeptCodes = [];
      slugMatches.forEach(function(m) {
        if (formDeptCodes.indexOf(m.dept.code) === -1) {
          formDeptCodes.push(m.dept.code);
        }
      });

      if (formDeptCodes.length > 0) {
        /* Store the raw slug so selectDept → selectForm picks the right form */
        window._urlFormCode        = formCode;
        window._filteredDeptCodes  = formDeptCodes;

        if (formDeptCodes.length === 1) {
          /* Only one dept — skip step 1 */
          renderFilteredDeptTiles(formDeptCodes);
          hideBackToDept();
          selectDept(formDeptCodes[0]);
        } else {
          /* Multiple depts — show filtered dept tiles (step 1) */
          renderFilteredDeptTiles(formDeptCodes);
          showStep(1);
        }
        return;
      }
      console.warn('AU Form: no Form_Config records found with slug="' + formCode +
        '". Check Form_Slug__c values in Form_Config__mdt. Showing all depts.');
    }

    /* ── SCENARIO 3: ?dept only → open that dept's default form directly ─
       Skip step 1, go straight to enquiry form.                           */
    if (deptCode && !formCode) {
      var deptObj = null;
      META.forEach(function(d) { if (d.code === deptCode) deptObj = d; });
      if (deptObj) {
        renderDeptTiles();
        hideBackToDept();
        selectDept(deptCode);  /* selectDept always goes to step 2 now */
        return;
      }
      console.warn('AU Form: deptCode "' + deptCode + '" not found.');
    }

    /* ── SCENARIO 4: No params → show all departments ─────────────────── */
    renderDeptTiles();
    showStep(1);
  });
})();
</script>

</body>
</html>
