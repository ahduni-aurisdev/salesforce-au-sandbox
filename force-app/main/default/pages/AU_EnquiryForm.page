function remoteCreateLead(payload, cb) {
  Visualforce.remoting.Manager.invokeAction(
    '{!$RemoteAction.AU_EnquiryFormController.createLead}',
    JSON.stringify(payload),
    function(result, event) { cb(result, event); },
    { escape: false }
  );
}

/* ── URL param reader ────────────────────────────────────────── */
function getURLParams() {
  var raw = new URLSearchParams(window.location.search);
  /* case-insensitive param lookup: utm_source, UTM_Source, Utm_Source all work */
  var p = { get: function(name) {
    var want = name.toLowerCase(), found = null;
    raw.forEach(function(v, k) { if (found === null && k.toLowerCase() === want) found = v; });
    return found;
  }};
  return {
    dept:     (p.get('dept') || p.get('department') || '').trim(),
    embed:    p.get('embed') === '1',          // CHANGE 1
    source:   p.get('UTM_Source')   || '',
    medium:   p.get('UTM_Medium')   || '',
    campaign: p.get('UTM_Campaign') || '',
    content:  p.get('UTM_Content')  || '',
    term:     p.get('UTM_Term')     || ''
  };
}

/* ── CHANGE 1: embed mode — add class to body ────────────────── */
function applyEmbedMode(isEmbed) {
  if (isEmbed) {
    document.body.classList.add('embed-mode');
