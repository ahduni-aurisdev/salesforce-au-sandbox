  var hdrEmail = document.getElementById('hdrContactEmail');
  if (hdrEmail) {
    hdrEmail.textContent = email;
    hdrEmail.href = 'mailto:' + email;
  }

  // 2. Hero phone
  var heroPhone = document.getElementById('heroContactPhone');
