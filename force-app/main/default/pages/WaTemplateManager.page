    state.menuIndex = (index + options.length) % options.length;
    Array.prototype.forEach.call(options, function (o, i) { o.classList.toggle('is-active', i === state.menuIndex); });
    $('switcher-menu').setAttribute('aria-activedescendant', 'acct-' + state.menuIndex);
    options[state.menuIndex].scrollIntoView({ block: 'nearest' });
  }
  function chooseAccount(index) {
