      store('clear');
      showSignin(error.message);
    }).then(function () { if (button) { setLoading(button, false); } });
  }

  /* ---------- Number switcher ---------- */
  function renderSwitcher() {
    var btn = $('switcher-btn');
    var account = currentAccount();
    if (account) {
      var p = parseLabel(account.label);
      btn.classList.remove('is-empty');
      btn.innerHTML = '<span class="avatar" aria-hidden="true">' + esc(initials(p.name)) + '</span><span class="switcher-text"><span class="switcher-name">' + esc(p.name) + '</span><span class="switcher-num">' + esc(p.number) + '</span></span>' + icon('chevron', 16);
      btn.setAttribute('aria-label', 'WhatsApp number: ' + p.name + ' ' + p.number + '. Change number');
    } else {
      btn.classList.add('is-empty');
      btn.innerHTML = icon('phone', 16) + '<span class="switcher-name">Choose a WhatsApp number</span>' + icon('chevron', 16);
      btn.setAttribute('aria-label', 'Choose a WhatsApp number');
    }
    var menu = $('switcher-menu');
    menu.innerHTML = state.accounts.length ? state.accounts.map(function (a, i) {
      var p = parseLabel(a.label);
      return '<li id="acct-' + i + '" class="menu-option" role="option" aria-selected="' + (a.wabaId === state.waba) + '" data-index="' + i + '">' +
        '<span class="avatar" aria-hidden="true">' + esc(initials(p.name)) + '</span><span class="switcher-text"><span class="switcher-name">' + esc(p.name) + '</span><span class="switcher-num">' + esc(p.number) + '</span></span>' +
        '<span class="tick">' + icon('check', 16) + '</span></li>';
