<title>WhatsApp Template Manager</title>
<style>
/* No CDATA wrapper here: Visualforce splits a CDATA section inside a style block into fragments on every line,
   which invalidates the whole stylesheet. This CSS uses no less-than or ampersand characters, so it is
   well-formed XHTML without CDATA. Keep it that way when editing. */
:root {
  --accent: #0E6E58; --accent-hover: #0A5644; --accent-soft: #E2F1EC; --on-accent: #FFFFFF;
  --bg: #F5F6F7; --surface: #FFFFFF; --surface-2: #F0F2F3; --surface-3: #E7EAEC;
  --border: #D9DEE1; --border-strong: #B9C1C6;
  --text: #1B2226; --text-2: #56626B; --text-3: #7A858D;
  --ok: #1B7A43; --ok-soft: #E3F4E9; --warn: #8A5A00; --warn-soft: #FFF3D1;
  --danger: #B42318; --danger-soft: #FDECEA; --neutral: #4B5560; --neutral-soft: #ECEFF1;
  --info: #0B5CAD; --info-soft: #E6F0FB;
  --focus: 0 0 0 3px rgba(14, 110, 88, 0.38);
  --radius: 10px; --radius-sm: 7px;
  --shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.10);
  --shadow-lg: 0 12px 32px rgba(16, 24, 40, 0.18);
  --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --accent: #2BA383; --accent-hover: #38B994; --accent-soft: #143A31; --on-accent: #06140F;
    --bg: #101416; --surface: #171C1F; --surface-2: #1E2428; --surface-3: #262D32;
    --border: #2E363B; --border-strong: #46525A;
    --text: #E7ECEE; --text-2: #A4AFB6; --text-3: #7E8A92;
    --ok: #5BCB8A; --ok-soft: #133524; --warn: #F0B94B; --warn-soft: #3A2E10;
    --danger: #F28B82; --danger-soft: #3D1A17; --neutral: #B3BDC4; --neutral-soft: #262D32;
    --info: #7CB6F2; --info-soft: #14283F;
    --focus: 0 0 0 3px rgba(43, 163, 131, 0.5);
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.4); --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.55);
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { font-family: var(--font); font-size: 14px; line-height: 1.45; color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }
[hidden] { display: none !important; }
button, input, select, textarea { font: inherit; color: inherit; }
a { color: var(--accent); }
:focus-visible { outline: none; box-shadow: var(--focus); }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.icon { flex: none; vertical-align: middle; }

/* Buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 0 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface); color: var(--text); font-weight: 600; cursor: pointer; white-space: nowrap; transition: background .15s, border-color .15s; }
.btn:hover { background: var(--surface-2); }
.btn:disabled { opacity: .55; cursor: not-allowed; }
.btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
.btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
.btn-ghost { border-color: transparent; background: transparent; }
.btn-ghost:hover { background: var(--surface-2); }
.btn-sm { min-height: 30px; padding: 0 10px; font-size: 13px; }
.btn-icon { width: 36px; padding: 0; }
.btn-sm.btn-icon { width: 30px; }
.btn .spinner { display: none; }
.btn.is-loading .spinner { display: inline-block; }
.btn.is-loading .btn-label-idle { display: none; }
.spinner { width: 16px; height: 16px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: spin .7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 2s; } .skeleton { animation: none !important; } }

/* Form controls */
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.field:last-child { margin-bottom: 0; }
.label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
.label { font-weight: 600; font-size: 13px; }
.optional { font-weight: 400; color: var(--text-3); }
.hint { font-size: 12.5px; color: var(--text-2); margin: 0; }
.counter { font-size: 12px; color: var(--text-3); font-variant-numeric: tabular-nums; }
.counter.over { color: var(--danger); font-weight: 600; }
.input, .select, .textarea { width: 100%; min-height: 38px; padding: 8px 11px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface); transition: border-color .15s; }
.input:hover, .select:hover, .textarea:hover { border-color: var(--text-3); }
.input:focus, .select:focus, .textarea:focus { outline: none; border-color: var(--accent); box-shadow: var(--focus); }
.textarea { min-height: 140px; resize: vertical; line-height: 1.5; }
.input[aria-invalid="true"], .textarea[aria-invalid="true"], .select[aria-invalid="true"] { border-color: var(--danger); }
.field-error { font-size: 12.5px; color: var(--danger); margin: 0; display: flex; gap: 6px; align-items: flex-start; }
.field-warn { font-size: 12.5px; color: var(--warn); background: var(--warn-soft); border-radius: var(--radius-sm); padding: 8px 10px; margin: 0; display: flex; gap: 8px; align-items: flex-start; }
.input-group { display: flex; gap: 8px; align-items: stretch; }
.input-group .input { flex: 1; min-width: 0; }
.check { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; }
.check input { margin-top: 3px; width: 16px; height: 16px; accent-color: var(--accent); }

/* Sign in */
.signin-page { min-height: 100vh; display: flex; flex-direction: column; }
.signin-header { background: var(--surface); border-bottom: 1px solid var(--border); }
.signin-header-inner { max-width: 1320px; margin: 0 auto; padding: 14px 20px; display: flex; align-items: center; gap: 12px; }
.signin-header .brand-mark { width: 34px; height: 34px; border-radius: 9px; flex: none; }
.signin-title { font-size: 17px; font-weight: 700; line-height: 1.2; margin: 0; }
.signin-org { font-size: 12.5px; color: var(--text-2); margin: 2px 0 0; }
.signin-wrap { flex: 1; display: flex; justify-content: center; align-items: flex-start; padding: 68px 16px 24px; }
.signin { width: 100%; max-width: 400px; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 32px 28px; box-shadow: var(--shadow); }
.brand-mark { width: 44px; height: 44px; border-radius: 12px; background: var(--accent); color: var(--on-accent); display: grid; place-items: center; }
.signin h1 { font-size: 20px; margin: 18px 0 4px; }
.signin p.lead { color: var(--text-2); margin: 0 0 22px; }
.signin .btn-primary { width: 100%; min-height: 40px; margin-top: 4px; }
.alert { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: var(--radius-sm); font-size: 13px; margin-bottom: 16px; }
.alert-error { background: var(--danger-soft); color: var(--danger); }
.alert-info { background: var(--info-soft); color: var(--info); }
.alert-warn { background: var(--warn-soft); color: var(--warn); }

/* App shell */
.topbar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 12px; padding: 10px 20px; background: var(--surface); border-bottom: 1px solid var(--border); }
.brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
.brand .brand-mark { width: 34px; height: 34px; border-radius: 9px; flex: none; }
.brand-text { min-width: 0; }
.brand-text p { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topbar-spacer { flex: 1; }
.switcher { position: relative; }
.switcher-btn { display: flex; align-items: center; gap: 10px; min-height: 42px; padding: 4px 12px 4px 6px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); cursor: pointer; max-width: 360px; }
.switcher-btn:hover { background: var(--surface-2); }
.switcher-btn.is-empty { border-style: dashed; border-color: var(--accent); color: var(--accent); padding-left: 12px; }
.avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; font-weight: 700; flex: none; }
.switcher-text { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; line-height: 1.2; }
.switcher-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }
.switcher-num { font-size: 12px; color: var(--text-2); font-variant-numeric: tabular-nums; }
.menu { position: absolute; top: calc(100% + 6px); left: 0; min-width: 300px; max-width: 90vw; max-height: 60vh; overflow: auto; margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-lg); z-index: 30; }
.switcher .menu { left: auto; right: 0; }
.menu-option { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius-sm); cursor: pointer; }
.menu-option[aria-selected="true"] { background: var(--accent-soft); }
.menu-option.is-active { box-shadow: inset 0 0 0 2px var(--accent); }
.menu-option:hover { background: var(--surface-2); }
.menu-option .tick { margin-left: auto; color: var(--accent); visibility: hidden; }
.menu-option[aria-selected="true"] .tick { visibility: visible; }
.container { max-width: 1320px; margin: 0 auto; padding: 20px; }
.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
.page-head h1 { font-size: 22px; margin: 0; }
.page-head .sub { color: var(--text-2); margin: 2px 0 0; font-variant-numeric: tabular-nums; }
.tabs { display: inline-flex; gap: 4px; padding: 4px; background: var(--surface-2); border-radius: var(--radius); }
.tab { border: 0; background: transparent; padding: 7px 16px; border-radius: var(--radius-sm); font-weight: 600; color: var(--text-2); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
.tab[aria-selected="true"] { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
.tab:disabled { cursor: not-allowed; opacity: .5; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
.empty-state { text-align: center; padding: 56px 24px; }
.empty-state .bubble-ill { width: 64px; height: 64px; border-radius: 18px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; margin: 0 auto 16px; }
.empty-state h2 { font-size: 18px; margin: 0 0 6px; }
.empty-state p { color: var(--text-2); margin: 0 auto 18px; max-width: 460px; }

/* Templates list */
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 14px 16px; border-bottom: 1px solid var(--border); }
.search { position: relative; flex: 1 1 240px; min-width: 200px; max-width: 360px; }
.search .icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-3); }
.search .input { padding-left: 34px; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; font-weight: 600; font-size: 13px; color: var(--text-2); }
.chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
.chip .count { font-variant-numeric: tabular-nums; font-weight: 500; opacity: .85; }
.updated { margin-left: auto; display: flex; align-items: center; gap: 8px; color: var(--text-3); font-size: 12.5px; }
.list { max-height: calc(100vh - 290px); min-height: 280px; overflow-y: auto; }
.row { border-bottom: 1px solid var(--border); }
.row:last-child { border-bottom: 0; }
.row-btn { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto auto 120px 20px; gap: 14px; align-items: center; padding: 12px 16px; border: 0; background: transparent; text-align: left; cursor: pointer; }
.row-btn:hover { background: var(--surface-2); }
.row-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); font-size: 13px; }
.row-lang { color: var(--text-2); font-size: 13px; white-space: nowrap; }
.row-cat { display: inline-flex; align-items: center; gap: 6px; color: var(--text-2); font-size: 13px; white-space: nowrap; }
.row .chev { color: var(--text-3); transition: transform .15s; }
.row-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }
.pill { display: inline-flex; align-items: center; gap: 6px; justify-self: start; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: .02em; }
.pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.pill-APPROVED { background: var(--ok-soft); color: var(--ok); }
.pill-PENDING, .pill-IN_APPEAL { background: var(--warn-soft); color: var(--warn); }
.pill-REJECTED { background: var(--danger-soft); color: var(--danger); }
.pill-other { background: var(--neutral-soft); color: var(--neutral); }
.row-detail { display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); gap: 24px; padding: 4px 16px 20px; }
.dl { display: grid; grid-template-columns: 140px 1fr; gap: 8px 12px; margin: 0 0 16px; font-size: 13px; }
.dl dt { color: var(--text-2); }
.dl dd { margin: 0; word-break: break-word; }
.mono { font-family: var(--mono); font-size: 12.5px; }
.actions { display: flex; gap: 8px; flex-wrap: wrap; }
.skeleton-row { display: grid; grid-template-columns: minmax(0, 1fr) 90px 90px 100px; gap: 14px; padding: 16px; border-bottom: 1px solid var(--border); }
.skeleton { height: 12px; border-radius: 6px; background: linear-gradient(90deg, var(--surface-2), var(--surface-3), var(--surface-2)); background-size: 200% 100%; animation: shimmer 1.2s ease-in-out infinite; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

/* Create form */
.create-grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 20px; align-items: start; }
.section { padding: 20px; border-bottom: 1px solid var(--border); }
.section:last-of-type { border-bottom: 0; }
.section-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
.step { width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 700; display: grid; place-items: center; flex: none; font-size: 13px; }
.section-head h2 { font-size: 16px; margin: 1px 0 2px; }
.section-head p { margin: 0; color: var(--text-2); font-size: 13px; }
.cat-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.cat-card { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 14px; border: 1px solid var(--border-strong); border-radius: var(--radius); cursor: pointer; background: var(--surface); }
.cat-card:hover { border-color: var(--text-3); }
.cat-card input { position: absolute; opacity: 0; pointer-events: none; }
.cat-card .cat-title { display: flex; align-items: center; gap: 8px; font-weight: 700; }
.cat-card .cat-desc { font-size: 12.5px; color: var(--text-2); }
.cat-card.is-checked { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); background: var(--accent-soft); }
.cat-card:focus-within { box-shadow: var(--focus); }
.segmented { display: flex; flex-wrap: wrap; gap: 6px; }
.seg { position: relative; }
.seg input { position: absolute; opacity: 0; pointer-events: none; }
.seg span { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 12px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); cursor: pointer; font-weight: 600; font-size: 13px; background: var(--surface); }
.seg input:checked + span { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
.seg input:focus-visible + span { box-shadow: var(--focus); }
.fmt-bar { display: flex; gap: 4px; align-items: center; padding: 4px; border: 1px solid var(--border-strong); border-bottom: 0; border-radius: var(--radius-sm) var(--radius-sm) 0 0; background: var(--surface-2); }
.fmt-bar + .textarea { border-radius: 0 0 var(--radius-sm) var(--radius-sm); }
.fmt-btn { min-width: 30px; height: 30px; border: 0; border-radius: 6px; background: transparent; cursor: pointer; font-size: 14px; }
.fmt-btn:hover { background: var(--surface-3); }
.fmt-sep { width: 1px; height: 18px; background: var(--border-strong); margin: 0 4px; }
.vars { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; padding: 12px; border-radius: var(--radius-sm); background: var(--surface-2); }
.vars .field { margin: 0; }
.var-tag { font-family: var(--mono); font-size: 12px; background: var(--surface-3); padding: 1px 6px; border-radius: 4px; }
.dropzone { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 22px; border: 1.5px dashed var(--border-strong); border-radius: var(--radius); text-align: center; color: var(--text-2); background: var(--surface); }
.dropzone.is-over { border-color: var(--accent); background: var(--accent-soft); }
.file-card { display: flex; gap: 12px; align-items: center; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius); }
.file-card .file-meta { flex: 1; min-width: 0; }
.file-card .file-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.progress { height: 6px; border-radius: 3px; background: var(--surface-3); overflow: hidden; margin-top: 6px; }
.progress > div { height: 100%; background: var(--accent); transition: width .2s; }
.btn-list { display: flex; flex-direction: column; gap: 10px; }
.btn-item { border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; background: var(--surface); }
.btn-item-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-weight: 600; }
.btn-item-head .grow { flex: 1; }
.btn-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
.btn-grid .field { margin: 0; }
.add-menu-wrap { position: relative; display: inline-block; }
.add-menu { position: absolute; bottom: calc(100% + 6px); left: 0; min-width: 260px; margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-lg); z-index: 15; }
.add-menu button { width: 100%; display: flex; gap: 10px; align-items: center; padding: 8px 10px; border: 0; border-radius: var(--radius-sm); background: transparent; text-align: left; cursor: pointer; }
.add-menu button:hover:not(:disabled) { background: var(--surface-2); }
.add-menu button:disabled { opacity: .5; cursor: not-allowed; }
.add-menu small { display: block; color: var(--text-3); font-size: 12px; }
.submit-bar { display: flex; gap: 10px; align-items: center; justify-content: flex-end; flex-wrap: wrap; padding: 16px 20px; border-top: 1px solid var(--border); background: var(--surface-2); border-radius: 0 0 var(--radius) var(--radius); }
.submit-bar .grow { flex: 1; color: var(--text-2); font-size: 13px; }
.preview-pane { position: sticky; top: 76px; }
.preview-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.preview-head h2 { font-size: 15px; margin: 0; }
.toggle { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-2); cursor: pointer; }
.toggle input { width: 16px; height: 16px; accent-color: var(--accent); }
.error-summary { margin: 0 20px 0; }
.error-summary ul { margin: 4px 0 0; padding-left: 18px; }

/* Dialog */
dialog { border: 0; padding: 0; border-radius: 14px; background: var(--surface); color: var(--text); box-shadow: var(--shadow-lg); width: min(860px, calc(100vw - 32px)); max-height: calc(100vh - 48px); }
dialog::backdrop { background: rgba(8, 12, 14, 0.55); }
.dlg-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border); }
.dlg-head h2 { margin: 0; font-size: 17px; }
.dlg-body { padding: 20px; display: grid; grid-template-columns: 1fr 340px; gap: 20px; overflow: auto; max-height: calc(100vh - 200px); }
.dlg-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 20px; border-top: 1px solid var(--border); background: var(--surface-2); }
.summary-dl { grid-template-columns: 120px 1fr; }
.summary-dl dd pre { margin: 0; white-space: pre-wrap; font-family: var(--font); }

/* Toasts */
.toasts { position: fixed; right: 16px; bottom: 16px; z-index: 100; display: flex; flex-direction: column; gap: 8px; width: min(380px, calc(100vw - 32px)); }
.toast { display: flex; gap: 10px; align-items: flex-start; padding: 12px 12px 12px 14px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); box-shadow: var(--shadow-lg); }
.toast.error { border-left-color: var(--danger); }
.toast .toast-msg { flex: 1; white-space: pre-line; }
.toast.error .icon { color: var(--danger); }
.toast.success .icon { color: var(--ok); }

/* WhatsApp preview (WhatsApp palettes) */
.wa { --wa-bg: #EFEAE2; --wa-head: #F0F2F5; --wa-head-text: #111B21; --wa-bubble: #FFFFFF; --wa-text: #111B21; --wa-meta: #667781; --wa-link: #027EB5; --wa-divider: #E9EDEF; --wa-media: #D1D7DB; --wa-doodle: rgba(0, 0, 0, 0.035); --wa-badge: #1D9BF0;
  border-radius: 22px; overflow: hidden; border: 1px solid var(--border); background: var(--wa-bg); font-family: var(--font); color: var(--wa-text); }
.wa.wa-dark { --wa-bg: #0B141A; --wa-head: #202C33; --wa-head-text: #E9EDEF; --wa-bubble: #202C33; --wa-text: #E9EDEF; --wa-meta: #8696A0; --wa-link: #53BDEB; --wa-divider: #2A3942; --wa-media: #2A3942; --wa-doodle: rgba(255, 255, 255, 0.025); }
.wa-head { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--wa-head); color: var(--wa-head-text); }
.wa-head .wa-back { opacity: .8; }
.wa-avatar { width: 36px; height: 36px; border-radius: 50%; background: #25D366; color: #FFFFFF; display: grid; place-items: center; font-weight: 700; flex: none; }
.wa-title { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
.wa-title b { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wa-title small { font-size: 12px; color: var(--wa-meta); }
.wa-badge { color: var(--wa-badge); flex: none; }
.wa-chat { padding: 14px 12px 18px; min-height: 260px; background-color: var(--wa-bg); background-image: radial-gradient(var(--wa-doodle) 1.2px, transparent 1.2px); background-size: 14px 14px; }
.wa-day { display: table; margin: 0 auto 12px; padding: 4px 10px; border-radius: 7px; background: var(--wa-bubble); color: var(--wa-meta); font-size: 12px; box-shadow: 0 1px .5px rgba(11, 20, 26, .13); }
.wa-msg { position: relative; margin-left: 8px; max-width: 92%; width: fit-content; min-width: 140px; }
.wa-tail { position: absolute; left: -8px; top: 0; width: 8px; height: 13px; color: var(--wa-bubble); }
.wa-bubble { background: var(--wa-bubble); border-radius: 0 7.5px 7.5px 7.5px; box-shadow: 0 1px .5px rgba(11, 20, 26, .13); overflow: hidden; }
.wa-inner { padding: 6px 7px 8px 9px; }
.wa-media { margin: 3px 3px 0; border-radius: 6px; overflow: hidden; background: var(--wa-media); position: relative; display: grid; place-items: center; min-height: 150px; color: var(--wa-meta); }
.wa-media img, .wa-media video { display: block; width: 100%; max-height: 260px; object-fit: cover; }
.wa-play { position: absolute; width: 48px; height: 48px; border-radius: 50%; background: rgba(11, 20, 26, .55); color: #FFFFFF; display: grid; place-items: center; }
.wa-doc { margin: 3px 3px 0; border-radius: 6px; background: rgba(134, 150, 160, .14); display: flex; align-items: center; gap: 10px; padding: 12px 10px; font-size: 13.5px; }
.wa-doc-icon { width: 30px; height: 36px; border-radius: 3px; background: #E5544B; color: #FFFFFF; display: grid; place-items: center; font-size: 9px; font-weight: 700; flex: none; }
.wa-doc small { display: block; color: var(--wa-meta); font-size: 11.5px; }
.wa-header-text { font-weight: 700; font-size: 15px; line-height: 20px; margin-bottom: 4px; word-wrap: break-word; }
.wa-body { font-size: 14.2px; line-height: 19px; white-space: pre-wrap; word-wrap: break-word; }
.wa-body code { font-family: var(--mono); font-size: 13px; }
.wa-var { background: rgba(37, 211, 102, .18); border-radius: 3px; padding: 0 2px; font-family: var(--mono); font-size: 12.5px; }
.wa-footer { font-size: 13px; line-height: 17px; color: var(--wa-meta); margin-top: 4px; }
.wa-time { float: right; margin: 6px 0 -4px 12px; font-size: 11px; color: var(--wa-meta); line-height: 15px; }
.wa-buttons { border-top: 1px solid var(--wa-divider); }
.wa-button { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 40px; padding: 0 12px; color: var(--wa-link); font-size: 14.2px; font-weight: 500; text-align: center; }
.wa-button + .wa-button { border-top: 1px solid var(--wa-divider); }
.wa-placeholder { color: var(--wa-meta); font-style: italic; }

/* Responsive */
@media (max-width: 1080px) {
  .create-grid { grid-template-columns: 1fr; }
  .preview-pane { position: static; }
  .dlg-body { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .topbar { flex-wrap: wrap; padding: 10px 16px; }
  .switcher { order: 3; flex-basis: 100%; }
  .switcher-btn { max-width: none; width: 100%; }
  .switcher .menu { left: 0; right: 0; min-width: 0; }
  .container { padding: 16px; }
  .cat-cards { grid-template-columns: 1fr; }
  .row-btn { grid-template-columns: minmax(0, 1fr) auto 20px; }
  .row-lang, .row-cat { display: none; }
  .row-detail { grid-template-columns: minmax(0, 1fr); }
  .search { max-width: none; min-width: 0; }
  .dl { grid-template-columns: 110px 1fr; }
  .updated { margin-left: 0; }
  .list { max-height: none; }
}
</style>
</head>
<body>
<div id="app" data-api-base="{!HTMLENCODE($Site.Prefix)}/services/apexrest/wa-template-api">

  <!-- Sign in -->
  <div id="signin-view" class="signin-page" hidden="hidden">
    <header class="signin-header">
      <div class="signin-header-inner">
        <div class="brand-mark" data-icon="chat" data-size="18"></div>
        <div>
          <p class="signin-title">WhatsApp Template Manager</p>
          <p class="signin-org">Ahmedabad University</p>
        </div>
      </div>
    </header>
    <main class="signin-wrap">
    <form id="signin-form" class="signin" novalidate="novalidate" autocomplete="off">
      <div class="brand-mark" data-icon="lock" data-size="22"></div>
      <h1>Sign in</h1>
      <p class="lead">Enter the admin key to view and create WhatsApp templates.</p>
      <div class="field">
        <label class="label" for="admin-key">Admin key</label>
        <div class="input-group">
          <input id="admin-key" class="input" type="password" autocomplete="off" spellcheck="false" required="required"/>
          <button id="toggle-key" type="button" class="btn btn-icon" aria-label="Show admin key" aria-pressed="false" data-icon="eye"></button>
        </div>
      </div>
      <button id="signin-btn" type="submit" class="btn btn-primary">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Sign in</span>
      </button>
    </form>
    </main>
  </div>

  <!-- App -->
  <div id="app-view" hidden="hidden">
    <header class="topbar">
      <div class="brand"><div class="brand-mark" data-icon="chat" data-size="18"></div><div class="brand-text"><p class="signin-title">WhatsApp Template Manager</p><p class="signin-org">Ahmedabad University</p></div></div>
      <div class="topbar-spacer"></div>
      <div class="switcher" id="switcher">
        <button id="switcher-btn" type="button" class="switcher-btn is-empty" aria-haspopup="listbox" aria-expanded="false" aria-controls="switcher-menu" aria-label="Choose a WhatsApp number"></button>
        <ul id="switcher-menu" class="menu" role="listbox" tabindex="-1" aria-label="WhatsApp numbers" hidden="hidden"></ul>
      </div>
      <button id="logout-btn" type="button" class="btn btn-ghost"><span data-icon="logout" data-size="16"></span><span>Log out</span></button>
    </header>

    <main class="container">
      <div class="page-head">
        <div>
          <h1 id="page-title">Choose a WhatsApp number</h1>
          <p id="page-sub" class="sub">Templates belong to a WhatsApp Business Account.</p>
        </div>
        <div class="tabs" role="tablist" aria-label="Sections">
          <button id="tab-list" class="tab" role="tab" type="button" aria-selected="true" aria-controls="panel-list" disabled="disabled">Templates</button>
          <button id="tab-create" class="tab" role="tab" type="button" aria-selected="false" aria-controls="panel-create" tabindex="-1" disabled="disabled"><span data-icon="plus" data-size="15"></span>New template</button>
        </div>
      </div>

      <section id="pick-prompt" class="card empty-state">
        <div class="bubble-ill" data-icon="phone" data-size="30"></div>
        <h2>Choose a WhatsApp number to start</h2>
        <p>Templates are stored per WhatsApp Business Account. Pick the number you want to work with to see its templates or create a new one.</p>
        <button id="pick-btn" type="button" class="btn btn-primary">Choose a number</button>
      </section>

      <section id="panel-list" class="card" role="tabpanel" aria-labelledby="tab-list" hidden="hidden">
        <div class="toolbar">
          <div class="search">
            <span data-icon="search" data-size="16"></span>
            <label class="sr-only" for="search-input">Search templates by name</label>
            <input id="search-input" class="input" type="search" placeholder="Search by template name" autocomplete="off"/>
          </div>
          <div id="filter-chips" class="chips" role="group" aria-label="Filter by status"></div>
          <div class="updated">
            <span id="updated-at" aria-live="polite"></span>
            <button id="refresh-btn" type="button" class="btn btn-sm">
              <span class="spinner" aria-hidden="true"></span>
              <span class="btn-label-idle" data-icon="refresh" data-size="14"></span>
              <span>Refresh</span>
            </button>
          </div>
        </div>
        <div id="list-notice" class="alert alert-warn" style="margin:12px 16px 0" hidden="hidden"></div>
        <div id="list-status" class="sr-only" aria-live="polite"></div>
        <div id="template-list" class="list" role="list" aria-label="Templates" aria-busy="false"></div>
      </section>

      <section id="panel-create" role="tabpanel" aria-labelledby="tab-create" hidden="hidden">
        <div class="create-grid">
          <form id="create-form" class="card" novalidate="novalidate" autocomplete="off">
            <div id="form-root"></div>
            <div id="form-errors" class="alert alert-error error-summary" role="alert" tabindex="-1" hidden="hidden"></div>
            <div class="submit-bar">
              <span class="grow">Meta reviews every template. Most reviews finish within minutes; some take up to 24 hours.</span>
              <button id="reset-btn" type="button" class="btn">Clear form</button>
              <button id="review-btn" type="submit" class="btn btn-primary">Review and submit</button>
            </div>
          </form>
          <aside class="preview-pane" aria-label="Template preview">
            <div class="preview-head">
              <h2>Preview</h2>
              <div style="display:flex;gap:6px;align-items:center">
                <label class="toggle"><input id="placeholder-toggle" type="checkbox"/>Show placeholders</label>
                <button id="theme-toggle" type="button" class="btn btn-sm btn-icon" aria-label="Switch preview to dark WhatsApp theme" data-icon="moon" data-size="15"></button>
              </div>
            </div>
            <div id="create-preview"></div>
          </aside>
        </div>
      </section>
    </main>
  </div>

  <dialog id="review-dialog" aria-labelledby="review-title">
    <div class="dlg-head">
      <h2 id="review-title">Review before submitting</h2>
      <button type="button" class="btn btn-ghost btn-icon" data-close="review" aria-label="Close review" data-icon="close"></button>
    </div>
    <div class="dlg-body">
      <div>
        <div id="review-summary"></div>
        <div class="alert alert-info" style="margin-top:16px">
          <span data-icon="info" data-size="16"></span>
          <span>After you submit, Meta reviews the template and may change its category if the content doesn't match. A Messaging account can create at most 100 templates per hour.</span>
        </div>
        <div id="review-error" class="alert alert-error" role="alert" hidden="hidden"></div>
      </div>
      <div id="review-preview"></div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn" data-close="review">Back to editing</button>
      <button id="submit-btn" type="button" class="btn btn-primary">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Submit to Meta</span>
      </button>
    </div>
  </dialog>

  <div id="toasts" class="toasts" aria-live="polite" aria-relevant="additions"></div>
  <input id="file-input" type="file" class="sr-only" tabindex="-1" aria-hidden="true"/>
</div>

