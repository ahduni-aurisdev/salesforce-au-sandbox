  }
  function signIn(key, button) {
    if (button) { setLoading(button, true); }
    return api('GET', { action: 'wabas' }, null, key).then(function (data) {
      state.key = key;
      store('set', key);
      state.accounts = data.accounts || [];
      $('signin-view').hidden = true;
      $('app-view').hidden = false;
      renderSwitcher();
      renderShell();
      if (!state.accounts.length) {
        toast('No WhatsApp numbers are enabled yet. Ask your Salesforce admin to add one in WA Account.', 'error');
      }
