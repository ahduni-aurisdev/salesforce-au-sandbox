  }
  function openMenu() {
    var menu = $('switcher-menu');
    menu.hidden = false;
    $('switcher-btn').setAttribute('aria-expanded', 'true');
    var selected = -1;
    state.accounts.forEach(function (a, i) { if (a.wabaId === state.waba) { selected = i; } });
    setActiveOption(selected >= 0 ? selected : 0);
    menu.focus();
  }
  function closeMenu(returnFocus) {
    $('switcher-menu').hidden = true;
    $('switcher-btn').setAttribute('aria-expanded', 'false');
    if (returnFocus) { $('switcher-btn').focus(); }
  }
  function setActiveOption(index) {
    var options = $('switcher-menu').querySelectorAll('[data-index]');
