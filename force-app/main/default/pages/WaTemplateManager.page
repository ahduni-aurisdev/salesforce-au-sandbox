    state.waba = account.wabaId;
    state.expanded = null; state.filter = 'ALL'; state.search = ''; $('search-input').value = '';
    if (state.form.media) { clearMedia(); }
    renderSwitcher();
    renderShell();
    selectTab('list');
    loadTemplates(false);
  }

  /* ---------- Shell & tabs ---------- */
  function renderShell() {
    var account = currentAccount();
    var has = !!account;
    $('pick-prompt').hidden = has;
    $('tab-list').disabled = !has;
    $('tab-create').disabled = !has;
    if (!has) {
      $('panel-list').hidden = true; $('panel-create').hidden = true;
      $('page-title').textContent = 'Choose a WhatsApp number';
      $('page-sub').textContent = 'Templates belong to a WhatsApp Business Account.';
      document.title = 'WhatsApp Template Manager';
      return;
    }
    var p = parseLabel(account.label);
    $('page-title').textContent = p.name;
    $('page-sub').textContent = (p.number ? p.number + ' · ' : '') + 'WhatsApp Business Account ' + account.wabaId;
    document.title = p.name + (p.number ? ' (' + p.number + ')' : '') + ' · WhatsApp Templates';
    $('panel-list').hidden = state.tab !== 'list';
    $('panel-create').hidden = state.tab !== 'create';
  }
  function selectTab(tab, focus) {
    state.tab = tab;
    var list = tab === 'list';
    $('tab-list').setAttribute('aria-selected', String(list)); $('tab-list').tabIndex = list ? 0 : -1;
    $('tab-create').setAttribute('aria-selected', String(!list)); $('tab-create').tabIndex = list ? -1 : 0;
    renderShell();
    if (!list) { renderForm(); }
    if (focus) { $(list ? 'tab-list' : 'tab-create').focus(); }
  }

  /* ---------- Templates list ---------- */
  function statusGroup(status) {
    if (status === 'PAUSED' || status === 'DISABLED') { return 'PAUSED_DISABLED'; }
    return status;
  }
  function loadTemplates(force) {
    var waba = state.waba;
    if (!waba) { return; }
    if (!force && state.cache[waba]) { renderList(); return; }
    var listNode = $('template-list');
    listNode.setAttribute('aria-busy', 'true');
    listNode.innerHTML = skeleton();
    $('list-status').textContent = 'Loading templates';
    setLoading($('refresh-btn'), true);
    api('GET', { action: 'list', wabaId: waba }).then(function (data) {
      state.cache[waba] = { templates: data.templates || [], truncated: !!data.truncated, updatedAt: new Date() };
      if (state.waba === waba) { renderList(); $('list-status').textContent = (data.count || 0) + ' templates loaded'; }
    }, function (error) {
      if (handleAuthError(error)) { return; }
      if (state.waba !== waba) { return; }
      listNode.innerHTML = '<div class="empty-state" role="alert"><div class="bubble-ill" style="color:var(--danger);background:var(--danger-soft)">' + icon('alert', 28) +
        '</div><h2>Couldn’t load templates</h2><p>' + esc(error.message) + '</p><button type="button" class="btn btn-primary" data-action="retry">Try again</button></div>';
    }).then(function () { listNode.setAttribute('aria-busy', 'false'); setLoading($('refresh-btn'), false); });
  }
  function skeleton() {
    var rows = '';
    for (var i = 0; i < 7; i++) {
      rows += '<div class="skeleton-row" aria-hidden="true"><div class="skeleton" style="width:' + (45 + (i * 13) % 40) + '%"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton" style="width:70%"></div></div>';
    }
    return rows;
  }
  function renderList() {
    var entry = state.cache[state.waba];
    if (!entry) { return; }
    var all = entry.templates;
    var counts = { ALL: all.length, APPROVED: 0, PENDING: 0, REJECTED: 0, PAUSED_DISABLED: 0 };
    all.forEach(function (t) { var g = statusGroup(t.status); if (counts[g] != null) { counts[g]++; } });
    if (state.filter === 'PAUSED_DISABLED' && !counts.PAUSED_DISABLED) { state.filter = 'ALL'; }
    $('filter-chips').innerHTML = STATUS_FILTERS.filter(function (f) { return !f.onlyIfAny || counts[f.id] > 0; }).map(function (f) {
      return '<button type="button" class="chip" aria-pressed="' + (state.filter === f.id) + '" data-filter="' + f.id + '">' + esc(f.name) + ' <span class="count">' + counts[f.id] + '</span></button>';
    }).join('');
    $('updated-at').textContent = 'Updated ' + fmtTime(entry.updatedAt);
    var notice = $('list-notice');
    notice.hidden = !entry.truncated;
    if (entry.truncated) { notice.innerHTML = icon('info', 16) + '<span>Showing the first ' + all.length + ' templates. This account has more than the page can load at once; search narrows only the loaded ones.</span>'; }

    var term = state.search.trim().toLowerCase();
    var shown = all.filter(function (t) {
      return (state.filter === 'ALL' || statusGroup(t.status) === state.filter) && (!term || String(t.name).toLowerCase().indexOf(term) >= 0);
    }).sort(function (a, b) { return String(a.name).localeCompare(String(b.name)) || String(a.language).localeCompare(String(b.language)); });

    var listNode = $('template-list');
    if (!all.length) {
      listNode.innerHTML = '<div class="empty-state"><div class="bubble-ill">' + icon('chat', 30) + '</div><h2>No templates yet</h2><p>This WhatsApp account has no message templates. Create the first one to send it from Marketing Cloud once Meta approves it.</p><button type="button" class="btn btn-primary" data-action="new">' + icon('plus', 16) + 'New template</button></div>';
      return;
    }
    if (!shown.length) {
      listNode.innerHTML = '<div class="empty-state"><div class="bubble-ill">' + icon('search', 28) + '</div><h2>No matching templates</h2><p>No templates match this search and filter. Clear them to see all templates.</p><button type="button" class="btn" data-action="clear-filters">Clear search and filter</button></div>';
      return;
    }
    listNode.innerHTML = shown.map(rowHtml).join('');
    $('list-status').textContent = shown.length + ' of ' + all.length + ' templates shown';
  }
  function categoryInfo(category) {
    for (var i = 0; i < CATEGORIES.length; i++) { if (CATEGORIES[i].id === category) { return CATEGORIES[i]; } }
    return { id: category, name: titleCase(category), icon: 'chat' };
  }
  function pill(status) {
    var known = { APPROVED: 1, PENDING: 1, REJECTED: 1, IN_APPEAL: 1 };
    return '<span class="pill ' + (known[status] ? 'pill-' + status : 'pill-other') + '">' + esc(titleCase(String(status || 'Unknown').replace(/_/g, ' '))) + '</span>';
  }
  function rowHtml(t) {
    var open = state.expanded === t.id;
    var cat = categoryInfo(t.category);
    var html = '<div class="row" role="listitem"><button type="button" class="row-btn" aria-expanded="' + open + '" aria-controls="detail-' + esc(t.id) + '" data-row="' + esc(t.id) + '">' +
      '<span class="row-name" title="' + esc(t.name) + '">' + esc(t.name) + '</span>' +
      '<span class="row-lang">' + esc(langName(t.language)) + '</span>' +
      '<span class="row-cat" title="' + esc(cat.name) + '">' + icon(cat.icon, 15) + '<span>' + esc(cat.name) + '</span></span>' +
      pill(t.status) + '<span class="chev">' + icon('chevron', 18) + '</span></button>';
    if (open) {
      var quality = t.quality_score && t.quality_score.score ? titleCase(t.quality_score.score) : 'Not available yet';
      html += '<div id="detail-' + esc(t.id) + '" class="row-detail"><div>' + renderPhone(modelFromMeta(t), { placeholders: false }) + '</div><div>' +
        '<dl class="dl"><dt>Template name</dt><dd class="mono">' + esc(t.name) + '</dd><dt>Template ID</dt><dd class="mono">' + esc(t.id) + '</dd>' +
        '<dt>Language</dt><dd>' + esc(langName(t.language)) + ' <span class="mono">(' + esc(t.language) + ')</span></dd>' +
        '<dt>Category</dt><dd>' + esc(cat.name) + '</dd><dt>Status</dt><dd>' + pill(t.status) + '</dd>' +
        (t.rejected_reason && t.rejected_reason !== 'NONE' ? '<dt>Rejection reason</dt><dd>' + esc(titleCase(t.rejected_reason.replace(/_/g, ' '))) + '</dd>' : '') +
        '<dt>Quality</dt><dd>' + esc(quality) + '</dd></dl>' +
        '<div class="actions"><button type="button" class="btn btn-sm" data-copy="' + esc(t.name) + '">' + icon('copy', 15) + 'Copy name</button>' +
        '<button type="button" class="btn btn-sm" data-duplicate="' + esc(t.id) + '">' + icon('plus', 15) + 'Duplicate as new</button></div>' +
        '<p class="hint" style="margin-top:12px">Templates can be deleted in WhatsApp Manager only. A deleted approved name can’t be reused for 30 days.</p></div></div>';
    }
    return html + '</div>';
  }
  function findTemplate(id) {
    var entry = state.cache[state.waba];
    if (!entry) { return null; }
    for (var i = 0; i < entry.templates.length; i++) { if (entry.templates[i].id === id) { return entry.templates[i]; } }
    return null;
  }
  function copyText(text) {
    var done = function () { toast('Copied "' + text + '".'); };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done, function () { toast('Couldn’t copy. Select the name and copy it manually.', 'error'); });
      return;
    }
    var area = document.createElement('textarea');
    area.value = text; area.setAttribute('readonly', ''); area.style.position = 'fixed'; area.style.opacity = '0';
    document.body.appendChild(area); area.select();
    try { document.execCommand('copy'); done(); } catch (e) { toast('Couldn’t copy. Select the name and copy it manually.', 'error'); }
    area.remove();
  }

  /* ---------- Preview model ---------- */
  function component(components, type) {
    for (var i = 0; i < (components || []).length; i++) { if (String(components[i].type).toUpperCase() === type) { return components[i]; } }
    return null;
  }
  function modelFromMeta(t) {
    var c = t.components || [];
    var header = component(c, 'HEADER'), body = component(c, 'BODY'), footer = component(c, 'FOOTER'), buttons = component(c, 'BUTTONS');
    var model = { headerType: 'NONE', headerText: '', headerSamples: [], mediaUrl: null, mediaName: null, body: body ? body.text || '' : '', bodySamples: [], footer: footer ? footer.text || '' : '', buttons: [] };
    if (header) {
      model.headerType = String(header.format || 'TEXT').toUpperCase();
      model.headerText = header.text || '';
      var hex = header.example || {};
      model.headerSamples = hex.header_text || [];
      if (hex.header_handle && hex.header_handle.length && /^https:\/\//.test(hex.header_handle[0])) { model.mediaUrl = hex.header_handle[0]; }
    }
    if (body && body.example && body.example.body_text && body.example.body_text.length) { model.bodySamples = body.example.body_text[0] || []; }
    if (buttons && buttons.buttons) {
      model.buttons = buttons.buttons.map(function (b) {
        var type = String(b.type).toUpperCase();
        if (type === 'OTP') { return { type: 'COPY_CODE', text: b.text || 'Copy code' }; }
        if (type === 'COPY_CODE') { return { type: 'COPY_CODE', text: 'Copy offer code' }; }
        return { type: type, text: b.text || titleCase(type) };
      });
    }
    return model;
  }
  function modelFromForm(f) {
    if (f.category === 'AUTHENTICATION') {
      var a = f.auth;
      var otpText = a.otpType === 'ONE_TAP' ? (a.autofillText || 'Autofill') : (a.copyText || 'Copy code');
      return {
        headerType: 'NONE', body: '*{{1}}* is your verification code.' + (a.security ? ' For your security, do not share this code.' : ''),
        bodySamples: ['123456'], footer: a.expiry ? 'This code expires in ' + (a.minutes || '?') + ' minutes.' : '',
        buttons: [{ type: 'COPY_CODE', text: otpText }], authPreview: true
      };
    }
    var samples = [];
    varNumbers(f.body).forEach(function (n) { samples[n - 1] = f.bodySamples[n] || ''; });
    return {
      headerType: f.headerType, headerText: f.headerText, headerSamples: [f.headerSample],
      mediaUrl: f.media && f.media.url, mediaName: f.media && f.media.name, mediaSize: f.media && f.media.size,
      body: f.body, bodySamples: samples, footer: f.footer,
      buttons: f.buttons.map(function (b) { return { type: b.type, text: b.type === 'COPY_CODE' ? 'Copy offer code' : b.text }; })
    };
  }

  /* ---------- WhatsApp formatting & preview ---------- */
  function fillVariables(text, samples, placeholders) {
    return esc(text).replace(/\{\{(\d+)\}\}/g, function (all, n) {
      var sample = samples && samples[Number(n) - 1];
      if (placeholders || !sample) { return '<span class="wa-var">{{' + n + '}}</span>'; }
      return esc(sample);
    });
  }
  function waFormat(html) {
    var codes = [];
    html = html.replace(/```([\s\S]+?)```/g, function (all, inner) { codes.push(inner); return '\u0000' + (codes.length - 1) + '\u0000'; });
    html = html.replace(/(^|[\s>(])\*(?!\s)([^*\n]+?)\*(?=$|[\s<.,!?:;)])/g, '$1<b>$2</b>');
    html = html.replace(/(^|[\s>(])_(?!\s)([^_\n]+?)_(?=$|[\s<.,!?:;)])/g, '$1<i>$2</i>');
    html = html.replace(/(^|[\s>(])~(?!\s)([^~\n]+?)~(?=$|[\s<.,!?:;)])/g, '$1<s>$2</s>');
