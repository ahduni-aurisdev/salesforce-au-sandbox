    var vars = (String(body || '').match(/\{\{\d+\}\}/g) || []).length;
    if (!vars) { return ''; }
    var words = String(body).replace(/\{\{\d+\}\}/g, ' ').split(/\s+/).filter(function (w) { return /[\p{L}\p{N}]/u.test(w); }).length;
    return words < vars * 3 ? 'This message has a lot of variables for its length. Meta often rejects these — add more fixed text around the variables.' : '';
  }

  /* ---------- Variables & formatting ---------- */
  function insertAtCursor(input, text) {
    var start = input.selectionStart == null ? input.value.length : input.selectionStart;
    var end = input.selectionEnd == null ? input.value.length : input.selectionEnd;
    input.value = input.value.slice(0, start) + text + input.value.slice(end);
    input.focus();
    input.setSelectionRange(start + text.length, start + text.length);
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }
  function wrapSelection(input, marker) {
    var start = input.selectionStart, end = input.selectionEnd, value = input.value;
    var selected = value.slice(start, end);
    input.value = value.slice(0, start) + marker + selected + marker + value.slice(end);
    input.focus();
    if (selected) { input.setSelectionRange(start, end + marker.length * 2); } else { input.setSelectionRange(start + marker.length, start + marker.length); }
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }

  /* ---------- Validation (mirrors WaTemplateValidator) ---------- */
  function validate() {
    var f = state.form, errors = {}, list = [];
    function add(key, message) { if (!errors[key]) { errors[key] = message; } list.push(message); }
    if (!f.name) { add('f-name', 'Enter a template name.'); }
    else if (!/^[a-z0-9_]+$/.test(f.name)) { add('f-name', 'The name can only contain lowercase letters, numbers and underscores.'); }
    else if (f.name.length > LIMITS.name) { add('f-name', 'The name can be at most 512 characters.'); }
    if (!f.language) { add('f-language', 'Choose a language.'); }
    if (f.category === 'AUTHENTICATION') {
      var a = f.auth;
      if (a.expiry && (!/^\d+$/.test(String(a.minutes)) || Number(a.minutes) < 1 || Number(a.minutes) > 90)) { add('f-minutes', 'Code expiry must be a whole number from 1 to 90 minutes.'); }
      if (a.copyText.length > LIMITS.buttonText || a.autofillText.length > LIMITS.buttonText) { add('f-apps', 'Button text can be at most 25 characters.'); }
      if (a.otpType === 'ONE_TAP') {
        a.apps.forEach(function (app, i) {
          if (!/^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z][a-zA-Z0-9_]*)+$/.test(app.package_name) || app.package_name.length > LIMITS.packageName) { add('f-apps', 'Android app ' + (i + 1) + ': enter a valid package name, for example com.example.app.'); }
          if (!/^[a-zA-Z0-9+\/=]{11}$/.test(app.signature_hash)) { add('f-apps', 'Android app ' + (i + 1) + ': the signature hash must be exactly 11 characters.'); }
        });
      }
      return { errors: errors, list: list };
    }
    if (f.headerType === 'TEXT') {
      var hv = (f.headerText.match(/\{\{[^{}]*\}\}/g) || []);
      if (!f.headerText.trim()) { add('f-headerText', 'Enter the header text, or choose None.'); }
      else if (f.headerText.length > LIMITS.headerText) { add('f-headerText', 'The header can be at most 60 characters.'); }
      else if (/[*_~`]/.test(f.headerText)) { add('f-headerText', 'The header can’t contain formatting characters (* _ ~ `).'); }
      else if (hv.length > 1 || (hv.length === 1 && hv[0] !== '{{1}}')) { add('f-headerText', 'The header can have only one variable, {{1}}.'); }
      else if (hv.length === 1 && !f.headerSample.trim()) { add('f-headerText', 'Enter a sample value for {{1}} in the header.'); }
    } else if (MEDIA[f.headerType]) {
      if (!f.media || f.media.status !== 'done') { add('f-media', f.media && f.media.status === 'uploading' ? 'Wait for the upload to finish.' : 'Upload a sample ' + MEDIA[f.headerType].label + ' for the header.'); }
    }
    var body = f.body;
    if (!body.trim()) { add('f-body', 'Enter the message body.'); }
    else {
      if (body.length > LIMITS.body) { add('f-body', 'The body can be at most 1024 characters.'); }
      var bad = (body.match(/\{\{[^{}]*\}\}/g) || []).filter(function (t) { return !/^\{\{[1-9]\d{0,2}\}\}$/.test(t); });
      if (bad.length) { add('f-body', 'Variables must be numbers in double braces, like {{1}}. Found ' + bad[0] + '.'); }
      if (/\{\{|\}\}/.test(body.replace(/\{\{[^{}]*\}\}/g, ''))) { add('f-body', 'The body has unmatched braces. Variables look like {{1}}.'); }
      var nums = varNumbers(body);
      for (var i = 0; i < nums.length; i++) { if (nums[i] !== i + 1) { add('f-body', 'Variables must be numbered in order with no gaps: {{1}}, {{2}}, {{3}}…'); break; } }
      var trimmed = body.trim();
      if (/^\{\{[^{}]*\}\}/.test(trimmed) || /\{\{[^{}]*\}\}$/.test(trimmed)) { add('f-body', 'The body can’t start or end with a variable. Add text before and after it.'); }
      if (nums.some(function (n) { return !String(f.bodySamples[n] || '').trim(); })) { add('f-body', 'Enter a sample value for every body variable.'); }
    }
    if (f.footer) {
      if (f.footer.length > LIMITS.footer) { add('f-footer', 'The footer can be at most 60 characters.'); }
      if (/\{\{|\}\}/.test(f.footer)) { add('f-footer', 'The footer can’t contain variables.'); }
    }
    var changes = 0, prev = null;
    f.buttons.forEach(function (b, i) {
      var key = 'b-' + i, label = 'Button ' + (i + 1) + ': ';
      var isQr = b.type === 'QUICK_REPLY';
      if (prev !== null && prev !== isQr) { changes++; }
      prev = isQr;
      if (b.type !== 'COPY_CODE' && (!b.text.trim() || b.text.length > LIMITS.buttonText)) { add(key, label + 'enter button text of up to 25 characters.'); }
      if (b.type === 'URL') {
        if (!/^https?:\/\/\S+$/.test(b.url) || /\{\{|\}\}/.test(b.url) || (b.url.length + (b.dynamic ? 5 : 0)) > LIMITS.url) { add(key, label + 'enter a website address starting with https://' + (b.dynamic ? ' (without {{1}}; it is added at the end)' : '') + '.'); }
        if (b.dynamic && (!b.sample.trim() || /\s/.test(b.sample))) { add(key, label + 'enter a sample value for {{1}} with no spaces.'); }
      }
      if (b.type === 'PHONE_NUMBER') {
        var phone = b.phone.replace(/[\s\-()]/g, '');
        if (!/^\+?\d{6,19}$/.test(phone) || phone.length > LIMITS.phone) { add(key, label + 'enter the phone number with country code, for example +91 79 0000 0000.'); }
      }
      if (b.type === 'COPY_CODE') {
        if (f.category !== 'MARKETING') { add(key, label + 'copy offer code buttons are only available for Marketing templates.'); }
        if (!b.code.trim() || b.code.length > LIMITS.copyCode || /\s/.test(b.code)) { add(key, label + 'enter a sample offer code of up to 20 characters with no spaces.'); }
      }
    });
    if (changes > 1) { add('f-buttons', 'Quick reply buttons must be grouped together, before or after the other buttons.'); }
    return { errors: errors, list: list };
  }
  function showErrors(result) {
    Array.prototype.forEach.call($('form-root').querySelectorAll('.field-error'), function (n) { n.hidden = true; n.textContent = ''; });
    Array.prototype.forEach.call($('form-root').querySelectorAll('[aria-invalid]'), function (n) { n.removeAttribute('aria-invalid'); });
    Object.keys(result.errors).forEach(function (key) {
      var node = $(key + '-error');
      if (node) { node.hidden = false; node.innerHTML = icon('alert', 14) + '<span>' + esc(result.errors[key]) + '</span>'; }
      var input = $(key);
      if (input) { input.setAttribute('aria-invalid', 'true'); }
    });
    var summary = $('form-errors');
    if (result.list.length) {
      summary.hidden = false;
      summary.innerHTML = icon('alert', 16) + '<div><strong>Fix ' + result.list.length + ' ' + (result.list.length === 1 ? 'problem' : 'problems') + ' before submitting:</strong><ul>' + result.list.map(function (m) { return '<li>' + esc(m) + '</li>'; }).join('') + '</ul></div>';
    } else { summary.hidden = true; summary.innerHTML = ''; }
  }

  /* ---------- Payload (Meta format) ---------- */
  function buildPayload() {
    var f = state.form;
    var payload = { name: f.name, language: f.language, category: f.category, components: [] };
    if (f.category === 'AUTHENTICATION') {
      var a = f.auth;
      payload.components.push({ type: 'BODY', add_security_recommendation: !!a.security });
      if (a.expiry) { payload.components.push({ type: 'FOOTER', code_expiration_minutes: Number(a.minutes) }); }
      var otp = { type: 'OTP', otp_type: a.otpType };
      if (a.copyText.trim()) { otp.text = a.copyText.trim(); }
      if (a.otpType === 'ONE_TAP') {
        if (a.autofillText.trim()) { otp.autofill_text = a.autofillText.trim(); }
        otp.supported_apps = a.apps.map(function (app) { return { package_name: app.package_name.trim(), signature_hash: app.signature_hash.trim() }; });
      }
      payload.components.push({ type: 'BUTTONS', buttons: [otp] });
      return payload;
    }
    if (f.headerType === 'TEXT') {
      var header = { type: 'HEADER', format: 'TEXT', text: f.headerText };
      if (varNumbers(f.headerText).length) { header.example = { header_text: [f.headerSample] }; }
      payload.components.push(header);
    } else if (MEDIA[f.headerType]) {
      payload.components.push({ type: 'HEADER', format: f.headerType, example: { header_handle: [f.media ? f.media.handle : ''] } });
    } else if (f.headerType === 'LOCATION') {
      payload.components.push({ type: 'HEADER', format: 'LOCATION' });
    }
    var body = { type: 'BODY', text: f.body };
    var nums = varNumbers(f.body);
    if (nums.length) { body.example = { body_text: [nums.map(function (n) { return f.bodySamples[n] || ''; })] }; }
    payload.components.push(body);
    if (f.footer.trim()) { payload.components.push({ type: 'FOOTER', text: f.footer }); }
    if (f.buttons.length) {
      payload.components.push({ type: 'BUTTONS', buttons: f.buttons.map(function (b) {
        if (b.type === 'QUICK_REPLY') { return { type: 'QUICK_REPLY', text: b.text.trim() }; }
        if (b.type === 'PHONE_NUMBER') { return { type: 'PHONE_NUMBER', text: b.text.trim(), phone_number: b.phone.replace(/[\s\-()]/g, '') }; }
        if (b.type === 'COPY_CODE') { return { type: 'COPY_CODE', example: b.code.trim() }; }
        var url = { type: 'URL', text: b.text.trim(), url: b.url.trim() + (b.dynamic ? '{{1}}' : '') };
        if (b.dynamic) { url.example = [b.url.trim() + b.sample.trim()]; }
        return url;
      }) });
    }
    return payload;
  }

  /* ---------- Review & submit ---------- */
  function openReview() {
    var result = validate();
    showErrors(result);
    if (result.list.length) { $('form-errors').focus(); return; }
    var f = state.form, account = currentAccount(), p = parseLabel(account.label);
    var cat = categoryInfo(f.category);
    var rows = [['WhatsApp number', esc(p.name + (p.number ? ' (' + p.number + ')' : ''))], ['Name', '<span class="mono">' + esc(f.name) + '</span>'], ['Language', esc(langName(f.language))], ['Category', esc(cat.name)]];
    if (f.category === 'AUTHENTICATION') {
      rows.push(['Security note', f.auth.security ? 'Included' : 'Not included']);
      rows.push(['Code expiry', f.auth.expiry ? esc(f.auth.minutes) + ' minutes' : 'Not shown']);
      rows.push(['Button', f.auth.otpType === 'ONE_TAP' ? 'One-tap autofill (' + f.auth.apps.length + ' app' + (f.auth.apps.length > 1 ? 's' : '') + ')' : 'Copy code']);
    } else {
      rows.push(['Header', f.headerType === 'NONE' ? 'None' : f.headerType === 'TEXT' ? esc(f.headerText) : esc(titleCase(f.headerType)) + (f.media ? ' — ' + esc(f.media.name) : '')]);
      rows.push(['Body', '<pre>' + esc(f.body) + '</pre>']);
      var nums = varNumbers(f.body);
      if (nums.length) { rows.push(['Samples', nums.map(function (n) { return '<span class="var-tag">{{' + n + '}}</span> ' + esc(f.bodySamples[n]); }).join('<br/>')]); }
      rows.push(['Footer', f.footer ? esc(f.footer) : 'None']);
      rows.push(['Buttons', f.buttons.length ? f.buttons.map(function (b) { return esc(BUTTON_TYPES[b.type].name) + (b.text ? ': ' + esc(b.text) : ''); }).join('<br/>') : 'None']);
    }
    $('review-summary').innerHTML = '<dl class="dl summary-dl">' + rows.map(function (r) { return '<dt>' + r[0] + '</dt><dd>' + r[1] + '</dd>'; }).join('') + '</dl>';
    $('review-preview').innerHTML = renderPhone(modelFromForm(f), { placeholders: false });
    $('review-error').hidden = true;
    state.lastFocus = document.activeElement;
    var dialog = $('review-dialog');
    if (typeof dialog.showModal === 'function') { dialog.showModal(); } else { dialog.setAttribute('open', 'open'); }
    $('submit-btn').focus();
  }
  function closeReview() {
    var dialog = $('review-dialog');
    if (dialog.open) { if (typeof dialog.close === 'function') { dialog.close(); } else { dialog.removeAttribute('open'); } }
  }
  function submitTemplate() {
    var button = $('submit-btn');
    if (!state.key || !state.waba || !$('review-dialog').open || button.disabled) { return; }
    var payload = buildPayload();
    var waba = state.waba;
    setLoading(button, true);
    $('review-error').hidden = true;
    api('POST', { action: 'create', wabaId: waba }, payload).then(function (data) {
      closeReview();
      var status = String(data.status || 'PENDING').toUpperCase();
      toast('Template "' + data.name + '" submitted. Meta status: ' + titleCase(status) + '.' + (data.category && data.category !== payload.category ? ' Meta set the category to ' + titleCase(data.category) + '.' : ''));
      state.form = emptyForm();
      state.filter = { APPROVED: 1, REJECTED: 1 }[status] ? status : 'PENDING';
      state.search = data.name; $('search-input').value = data.name;
      state.expanded = null;
      selectTab('list');
      loadTemplates(true);
    }, function (error) {
      if (handleAuthError(error)) { closeReview(); return; }
      var box = $('review-error');
      box.hidden = false;
      box.innerHTML = icon('alert', 16) + '<span>' + esc(error.message) + '</span>';
      box.focus();
    }).then(function () { setLoading(button, false); });
  }

  /* ---------- Upload ---------- */
  function clearMedia() {
    if (state.uploadXhr) { state.uploadXhr.abort(); state.uploadXhr = null; }
    if (state.form.media && state.form.media.url) { URL.revokeObjectURL(state.form.media.url); }
    state.form.media = null;
  }
  function refreshMedia() {
    var box = $('media-box');
    if (box) { box.innerHTML = mediaBoxHtml(state.form); bindDropzone(); }
    updatePreview();
  }
  function handleFile(file) {
    var f = state.form, spec = MEDIA[f.headerType];
    if (!file || !spec) { return; }
    var type = file.type === 'image/jpg' ? 'image/jpeg' : file.type;
    if (spec.types.indexOf(type) < 0) { toast('This header needs ' + spec.hint.split(',')[0] + '. "' + file.name + '" is a different type.', 'error'); return; }
    if (file.size > LIMITS.upload) { toast('"' + file.name + '" is ' + fmtSize(file.size) + '. The limit here is 4 MB. Compress it and try again.', 'error'); return; }
    if (!file.size) { toast('"' + file.name + '" is empty. Choose another file.', 'error'); return; }
    clearMedia();
    f.media = { name: file.name, size: file.size, type: type, url: URL.createObjectURL(file), status: 'uploading', progress: 0, handle: null };
    refreshMedia();
    var xhr = new XMLHttpRequest();
    state.uploadXhr = xhr;
    xhr.open('POST', API + '?' + query({ action: 'upload', fileName: file.name, fileType: type }));
    xhr.setRequestHeader('X-Admin-Key', state.key);
    xhr.setRequestHeader('Content-Type', 'application/octet-stream');
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.upload.onprogress = function (e) {
      if (!e.lengthComputable || f.media == null) { return; }
      f.media.progress = Math.min(99, Math.round((e.loaded / e.total) * 100));
      var bar = $('media-box') && $('media-box').querySelector('.progress');
      if (bar) { bar.setAttribute('aria-valuenow', f.media.progress); bar.firstChild.style.width = f.media.progress + '%'; bar.previousSibling.textContent = fmtSize(f.media.size) + ' · Uploading… ' + f.media.progress + '%'; }
    };
    xhr.onload = function () {
      state.uploadXhr = null;
      var data = null;
      try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
      if (!f.media) { return; }
      if (xhr.status === 401) { signOut(data && data.error); return; }
      if (xhr.status >= 200 && xhr.status < 300 && data && data.ok && data.header_handle) {
        f.media.status = 'done'; f.media.progress = 100; f.media.handle = data.header_handle;
        toast('Sample ' + spec.label + ' uploaded.');
      } else {
        f.media.status = 'error';
        f.media.error = data && data.error ? data.error : 'Upload failed (HTTP ' + xhr.status + '). Try again.';
        toast(f.media.error, 'error');
      }
      refreshMedia();
    };
    xhr.onerror = function () {
      state.uploadXhr = null;
      if (!f.media) { return; }
      f.media.status = 'error'; f.media.error = 'Upload failed. Check your connection and try again.';
      toast(f.media.error, 'error');
      refreshMedia();
    };
    xhr.send(file);
  }
  function bindDropzone() {
    var zone = $('dropzone');
    if (!zone) { return; }
    ['dragenter', 'dragover'].forEach(function (name) { zone.addEventListener(name, function (e) { e.preventDefault(); zone.classList.add('is-over'); }); });
    ['dragleave', 'drop'].forEach(function (name) { zone.addEventListener(name, function (e) { e.preventDefault(); zone.classList.remove('is-over'); }); });
    zone.addEventListener('drop', function (e) { if (e.dataTransfer && e.dataTransfer.files.length) { handleFile(e.dataTransfer.files[0]); } });
  }

  /* ---------- Duplicate ---------- */
  function duplicate(t) {
    var f = emptyForm();
    var c = t.components || [];
    f.category = CATEGORIES.some(function (x) { return x.id === t.category; }) ? t.category : 'MARKETING';
    var suffix = '_copy';
    f.name = String(t.name || '').slice(0, LIMITS.name - suffix.length) + suffix;
    f.language = LANG_NAMES[t.language] ? t.language : '';
    var header = component(c, 'HEADER'), body = component(c, 'BODY'), footer = component(c, 'FOOTER'), buttons = component(c, 'BUTTONS');
    var mediaNote = false;
    if (f.category === 'AUTHENTICATION') {
      f.auth.security = !!(body && /do not share/i.test(body.text || ''));
      var minutes = footer && /(\d+)/.exec(footer.text || '');
      f.auth.expiry = !!minutes; if (minutes) { f.auth.minutes = Number(minutes[1]); }
      var otp = buttons && buttons.buttons && buttons.buttons[0];
      if (otp && String(otp.otp_type || '').toUpperCase() === 'ONE_TAP') { f.auth.otpType = 'ONE_TAP'; }
    } else {
      if (header) {
        var format = String(header.format || 'TEXT').toUpperCase();
        f.headerType = ['TEXT', 'IMAGE', 'VIDEO', 'DOCUMENT', 'LOCATION'].indexOf(format) >= 0 ? format : 'NONE';
        if (format === 'TEXT') { f.headerText = header.text || ''; f.headerSample = (header.example && header.example.header_text && header.example.header_text[0]) || ''; }
        if (MEDIA[format]) { mediaNote = true; }
      }
      if (body) {
        f.body = body.text || '';
        var samples = body.example && body.example.body_text && body.example.body_text[0] || [];
        samples.forEach(function (s, i) { f.bodySamples[i + 1] = s; });
      }
      f.footer = footer ? footer.text || '' : '';
      if (buttons && buttons.buttons) {
        buttons.buttons.forEach(function (b) {
          var type = String(b.type).toUpperCase();
          if (!BUTTON_TYPES[type]) { return; }
          var item = newButton(type);
          item.text = b.text || '';
          if (type === 'URL') {
            var url = b.url || '';
            item.dynamic = /\{\{1\}\}$/.test(url);
            item.url = url.replace(/\{\{1\}\}$/, '');
            var ex = b.example && b.example[0];
            if (item.dynamic && ex && ex.indexOf(item.url) === 0) { item.sample = ex.slice(item.url.length); }
          }
          if (type === 'PHONE_NUMBER') { item.phone = b.phone_number || ''; }
          if (type === 'COPY_CODE') { item.code = Array.isArray(b.example) ? b.example[0] || '' : b.example || ''; }
          f.buttons.push(item);
        });
      }
    }
    state.form = f;
    selectTab('create');
    window.scrollTo(0, 0);
    $('f-name').focus();
    toast('Copied "' + t.name + '" into a new template. Change the name before submitting.' + (mediaNote ? ' Upload the header sample again.' : ''));
  }
  function newButton(type) { return { type: type, text: '', url: '', dynamic: false, sample: '', phone: '', code: '' }; }
  function addButton(type) {
    var list = state.form.buttons, item = newButton(type);
    var isQr = type === 'QUICK_REPLY', lastSame = -1;
    list.forEach(function (b, i) { if ((b.type === 'QUICK_REPLY') === isQr) { lastSame = i; } });
    if (lastSame >= 0) { list.splice(lastSame + 1, 0, item); } else { list.push(item); }
    renderForm();
    var index = list.indexOf(item);
    var focusTarget = $('b-text-' + index) || $('b-code-' + index);
    if (focusTarget) { focusTarget.focus(); }
  }

  /* ---------- Events ---------- */
  function bind() {
    hydrateIcons(document);

    $('signin-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var key = $('admin-key').value;
      if (!key) { showSignin('Enter the admin key to continue.'); return; }
      signIn(key, $('signin-btn'));
    });
    $('toggle-key').addEventListener('click', function () {
      var input = $('admin-key'), show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      this.setAttribute('aria-pressed', String(show));
      this.setAttribute('aria-label', show ? 'Hide admin key' : 'Show admin key');
      this.innerHTML = icon(show ? 'eyeOff' : 'eye', 18);
      input.focus();
    });
    $('logout-btn').addEventListener('click', function () { signOut(); toast('Signed out.'); });

    var switcherBtn = $('switcher-btn'), menu = $('switcher-menu');
    switcherBtn.addEventListener('click', function () { if (menu.hidden) { openMenu(); } else { closeMenu(true); } });
    switcherBtn.addEventListener('keydown', function (e) { if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); openMenu(); } });
    $('pick-btn').addEventListener('click', function () { openMenu(); });
    menu.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActiveOption(state.menuIndex + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActiveOption(state.menuIndex - 1); }
      else if (e.key === 'Home') { e.preventDefault(); setActiveOption(0); }
      else if (e.key === 'End') { e.preventDefault(); setActiveOption(-1); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); chooseAccount(state.menuIndex); }
      else if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
      else if (e.key === 'Tab') { closeMenu(false); }
    });
    menu.addEventListener('click', function (e) { var option = e.target.closest('[data-index]'); if (option) { chooseAccount(Number(option.getAttribute('data-index'))); } });
    document.addEventListener('click', function (e) {
