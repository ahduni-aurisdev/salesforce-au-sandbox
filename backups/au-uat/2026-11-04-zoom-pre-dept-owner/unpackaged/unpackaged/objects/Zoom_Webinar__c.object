        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Registered_Count__c</fullName>
        <label>Registered</label>
        <summaryFilterItems>
            <field>Zoom_Registration__c.Is_Registered__c</field>
