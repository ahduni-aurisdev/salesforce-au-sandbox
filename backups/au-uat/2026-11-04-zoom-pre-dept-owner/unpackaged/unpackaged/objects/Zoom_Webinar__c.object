        <fullName>Timezone__c</fullName>
        <externalId>false</externalId>
        <label>Timezone</label>
        <length>60</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <description>Whether this Zoom session is a Webinar or a Meeting. Set by the Zoom integration.</description>
        <label>Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Webinar</fullName>
                    <default>true</default>
                    <label>Webinar</label>
                </value>
                <value>
                    <fullName>Meeting</fullName>
                    <default>false</default>
                    <label>Meeting</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Walk_In_Count__c</fullName>
        <label>Joined Without Registration</label>
        <summaryFilterItems>
            <field>Zoom_Registration__c.Is_Registered__c</field>
            <operation>equals</operation>
            <value>False</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Zoom_Registration__c.Attended__c</field>
            <operation>equals</operation>
