    <fields>
        <fullName>Admission_Year__c</fullName>
        <description>Admission Year written to Leads created from this session; also part of the Lead match. Values mirror Lead.Admission_Year__c. Set manually; Zoom does not send it.</description>
        <inlineHelpText>Set this and Department so the scheduled sync can create or update Leads for this session&apos;s registrants.</inlineHelpText>
        <label>Admission Year</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Admission Year - 2025</fullName>
                    <default>false</default>
                    <label>Admission Year - 2025</label>
                </value>
                <value>
                    <fullName>Admission Year - 2026</fullName>
                    <default>false</default>
                    <label>Admission Year - 2026</label>
                </value>
                <value>
                    <fullName>Admission Year - 2027</fullName>
                    <default>false</default>
                    <label>Admission Year - 2027</label>
                </value>
                <value>
                    <fullName>Admission Year - 2028</fullName>
                    <default>false</default>
                    <label>Admission Year - 2028</label>
                </value>
                <value>
                    <fullName>Admission Year - 2029</fullName>
                    <default>false</default>
                    <label>Admission Year - 2029</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Attendance_Rate__c</fullName>
        <formula>IF(Registered_Count__c &gt; 0, Attended_Count__c / Registered_Count__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Attendance Rate</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Attended_Count__c</fullName>
        <label>Registered &amp; Attended</label>
        <summaryFilterItems>
            <field>Zoom_Registration__c.Is_Registered__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>Zoom_Registration__c.Attended__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>Zoom_Registration__c.Webinar__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Department__c</fullName>
        <description>Department whose Leads this session&apos;s registrants become. Each value&apos;s API name is the Lead Record Type developer name and its label is written to Lead.Department__c. Set manually; Zoom does not send it. Leads are created by the scheduled sync only when Department and Admission Year are both set.</description>
        <inlineHelpText>Set this and Admission Year so the scheduled sync can create or update Leads for this session&apos;s registrants.</inlineHelpText>
        <label>Department</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Undergraduation</fullName>
                    <default>false</default>
                    <label>Undergraduation</label>
                </value>
                <value>
                    <fullName>Graduation</fullName>
                    <default>false</default>
                    <label>Graduation</label>
                </value>
                <value>
                    <fullName>Masters</fullName>
                    <default>false</default>
                    <label>Masters</label>
                </value>
                <value>
                    <fullName>Phd</fullName>
                    <default>false</default>
                    <label>PhD</label>
                </value>
                <value>
                    <fullName>Executive_Education</fullName>
                    <default>false</default>
                    <label>Executive Education</label>
                </value>
                <value>
                    <fullName>CDC</fullName>
                    <default>false</default>
                    <label>Career Development Centre</label>
                </value>
                <value>
                    <fullName>CLeF</fullName>
                    <default>false</default>
                    <label>CLeF</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Duration_Minutes__c</fullName>
        <externalId>false</externalId>
        <label>Duration (Minutes)</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
