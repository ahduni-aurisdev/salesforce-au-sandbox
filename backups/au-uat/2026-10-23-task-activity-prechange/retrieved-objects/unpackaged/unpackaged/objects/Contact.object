    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Contact_Preferred_Email</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
            ISPICKVAL( npe01__Preferred_Email__c ,&quot;&quot;),
            OR(
            LEN(npe01__AlternateEmail__c  )&gt;0,
            LEN(npe01__WorkEmail__c )&gt;0,
            LEN(npe01__HomeEmail__c  )&gt;0
            )
            )</errorConditionFormula>
        <errorDisplayField>npe01__Preferred_Email__c</errorDisplayField>
        <errorMessage>Please select a Preferred Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Contact_Preferred_Phone</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
            ISPICKVAL(npe01__PreferredPhone__c ,&quot;&quot;),
            OR(
            LEN(MobilePhone)&gt;0,
            LEN( npe01__WorkPhone__c)&gt;0,
            LEN( OtherPhone )&gt;0
            )
            )</errorConditionFormula>
        <errorDisplayField>npe01__PreferredPhone__c</errorDisplayField>
        <errorMessage>Please select a Preferred Phone</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Phone_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND( MailingCountry  =&apos;India&apos;, OR(LEN( MobilePhone )&gt;13 , LEN(MobilePhone) &lt; 10 )),TRUE,FALSE)</errorConditionFormula>
        <errorDisplayField>MobilePhone</errorDisplayField>
        <errorMessage>Enter Valid Mobile Number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_City</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND(RecordType.Name = &apos;Organization&apos;, ISBLANK( MailingCity )),True,false)</errorConditionFormula>
        <errorDisplayField>MailingCity</errorDisplayField>
        <errorMessage>City Required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Name</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND(RecordType.Name = &apos;Organization&apos;, OR(ISBLANK(FirstName),  ISPICKVAL(Salutation , &apos;&apos;))),True,False)</errorConditionFormula>
        <errorMessage>First Name &amp; Salutation Required</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>Copy_Address_to_Household</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Copy Address to Household</masterLabel>
        <openType>sidebar</openType>
        <protected>false</protected>
        <url>/apex/npsp__ADDR_CopyAddrHHObjBTN?id={!Contact.Id}</url>
    </webLinks>
    <webLinks>
        <fullName>GoogleMaps</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Maps</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://maps.google.com/maps?f=q&amp;hl=en&amp;q={!Contact_MailingStreet}+{!Contact_MailingCity}+{!Contact_MailingState}&amp;om=1</url>
    </webLinks>
