    <recordTypes>
        <fullName>Organization</fullName>
        <active>true</active>
        <compactLayoutAssignment>Contact_Compact</compactLayoutAssignment>
        <label>Organization</label>
        <picklistValues>
            <picklist>GenderIdentity</picklist>
            <values>
                <fullName>Female</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Male</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Nonbinary</fullName>
                <default>false</default>
