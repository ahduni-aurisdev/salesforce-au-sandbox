    <validationRules>
        <fullName>Required_City</fullName>
        <active>true</active>
        <errorConditionFormula>IF(AND(RecordType.Name = &apos;Organization&apos;, ISBLANK( BillingCity  )),True,false)</errorConditionFormula>
        <errorDisplayField>BillingCity</errorDisplayField>
        <errorMessage>City Required</errorMessage>
    </validationRules>
