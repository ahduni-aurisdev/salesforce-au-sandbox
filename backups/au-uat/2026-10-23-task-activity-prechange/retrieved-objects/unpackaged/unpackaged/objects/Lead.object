    <fields>
        <fullName>MC_Phone_Number__c</fullName>
        <externalId>false</externalId>
        <formula>VALUE(IF(
  ISBLANK(MobilePhone),
  &quot;91&quot;+RIGHT(SUBSTITUTE(Phone, &quot; &quot;, &quot;&quot;), 10),
  &quot;91&quot;+RIGHT(SUBSTITUTE(MobilePhone, &quot; &quot;, &quot;&quot;), 10)
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>MC Phone Number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
