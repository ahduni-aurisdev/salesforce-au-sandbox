    <validationRules>
        <fullName>CDC_Required_Field_Validation</fullName>
        <active>true</active>
        <description>Account, COntact, Academic Year&apos;s are required for CDC record type</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;CDC&quot;,
    OR(
        ISBLANK(Account__c),
        ISBLANK(Contact__c),
        ISBLANK( TEXT(Academic_Year__c))
    )
)</errorConditionFormula>
        <errorMessage>Account, Contact, and Academic Year are required for CDC Leads.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Other_Lead_Source</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( LeadSource ,&quot;Other&quot;) &amp;&amp; ISBLANK( Other_Lead_Source__c )</errorConditionFormula>
        <errorDisplayField>Other_Lead_Source__c</errorDisplayField>
        <errorMessage>Lead Source is Other Please Fill Other Lead Source</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Phone_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT(ISBLANK(Phone)),
Country = &apos;India&apos;,
OR(
NOT(REGEX(Phone, &quot;^[0-9]*$&quot;)),
LEN(Phone) &gt; 13,
LEN(Phone) &lt; 10
)
)</errorConditionFormula>
        <errorDisplayField>Phone</errorDisplayField>
        <errorMessage>Kindly Enter Valid Mobile Number</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Entrance_Test_Score</fullName>
        <active>true</active>
        <errorConditionFormula>AND (RecordType.DeveloperName = &apos;Graduate&apos;,ISPICKVAL(  Entrance_Test_Status__c , &apos;My entrance test score / percentile is declared&apos;), Entrance_Test_Score_or_Percentile__c = 0)</errorConditionFormula>
        <errorDisplayField>Entrance_Test_Score_or_Percentile__c</errorDisplayField>
        <errorMessage>Entrance Test Score or Percentile cannot be blank or zero if Test Status declare</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Rating_When_Lead_Source_Spoken</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(PRIORVALUE(Status), &apos;Spoken&apos;),ISPICKVAL(Rating, &apos;&apos;)  )</errorConditionFormula>
        <errorDisplayField>Rating</errorDisplayField>
        <errorMessage>Rating Required When Lead Status is spoken</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>phone_or_email_not_be_empty</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISBLANK(Phone),
ISBLANK(Email)
)</errorConditionFormula>
        <errorMessage>Please enter either a phone number or an email address.</errorMessage>
    </validationRules>
