    <fields>
        <fullName>Certificate_Lead_Score__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    AND(
        Department__c = &quot;Executive Education&quot;,
        Programme_Interested_in__c = &quot;Fin4NonFin&quot;
    ),

    /* Critical validation override */
    IF(
        OR(
            /* Phone invalid */
            ISBLANK(Phone),
            LEFT(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            SUBSTITUTE(
                                SUBSTITUTE(Phone, &quot; &quot;, &quot;&quot;),
                                &quot;-&quot;, &quot;&quot;),
                            &quot;(&quot;, &quot;&quot;),
                        &quot;)&quot;, &quot;&quot;),
                    &quot;+&quot;, &quot;&quot;
                ), 1
            ) = &quot;0&quot;,
            LEN(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            SUBSTITUTE(
                                SUBSTITUTE(Phone, &quot; &quot;, &quot;&quot;),
                                &quot;-&quot;, &quot;&quot;),
                            &quot;(&quot;, &quot;&quot;),
                        &quot;)&quot;, &quot;&quot;),
                    &quot;+&quot;, &quot;&quot;
                )
            ) &lt; 10,
            LEN(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            SUBSTITUTE(
                                SUBSTITUTE(Phone, &quot; &quot;, &quot;&quot;),
                                &quot;-&quot;, &quot;&quot;),
                            &quot;(&quot;, &quot;&quot;),
                        &quot;)&quot;, &quot;&quot;),
                    &quot;+&quot;, &quot;&quot;
                )
            ) &gt; 15,

            /* Email invalid */
            ISBLANK(Email) = FALSE &amp;&amp;
            NOT(
                AND(
                    CONTAINS(Email, &quot;@&quot;),
                    CONTAINS(
                        RIGHT(
                            Email,
                            LEN(Email) - FIND(&quot;@&quot;, Email)
                        ),
                        &quot;.&quot;
                    ),
                    NOT(CONTAINS(Email, &quot; &quot;))
                )
            )
        ),
        -999, /* Critical failure */
        
        /* Normal scoring logic */
        /* Name */
        IF(NOT(ISBLANK(Name__c)), 1, 0) +

        /* Phone (already valid if here) */
        1 +

        /* Email (already valid if here) */
        1 +

        /* Highest Qualification */
        IF(NOT(ISBLANK(My_Highest_Qualification__c)), 2, 0) +

        /* Total Work Experience (TEXT, must contain at least one number) */
        IF(
            NOT(ISBLANK(Total_Work_Experience_Year_s__c)),
            IF(
                OR(
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;0&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;1&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;2&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;3&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;4&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;5&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;6&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;7&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;8&quot;),
                    CONTAINS(Total_Work_Experience_Year_s__c, &quot;9&quot;)
                ),
                2,
                -1
            ),
            0
        ) +

        /* Organisation / Institute */
        IF(NOT(ISBLANK(Organisation_Institute_Name__c)), 2, 0)
    ),

NULL
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Lead Score Certificate Course</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>City_Location__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    OR(
        CONTAINS(LOWER(City), &quot;bang&quot;),
        CONTAINS(LOWER(School_City__c), &quot;bang&quot;)
    ),
    &quot;Bengaluru&quot;,

IF(
    OR(
        CONTAINS(LOWER(City), &quot;kol&quot;),
        CONTAINS(LOWER(School_City__c), &quot;kol&quot;),
        CONTAINS(LOWER(City), &quot;calc&quot;),
        CONTAINS(LOWER(School_City__c), &quot;calc&quot;)
    ),
    &quot;Kolkata&quot;,

IF(
    OR(
        CONTAINS(LOWER(City), &quot;jamna&quot;),
        CONTAINS(LOWER(School_City__c), &quot;jamna&quot;)
    ),
    &quot;Jamnagar&quot;,

IF(
    OR(
        CONTAINS(LOWER(City), &quot;rajkot&quot;),
        CONTAINS(LOWER(School_City__c), &quot;rajkot&quot;)
    ),
    &quot;Rajkot&quot;,

IF(
    OR(
        CONTAINS(LOWER(City), &quot;surat&quot;),
        CONTAINS(LOWER(School_City__c), &quot;surat&quot;)
    ),
    &quot;Surat&quot;,

/* Default fallback */
BLANKVALUE(City, School_City__c)
)))))</formula>
