<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Account_Id__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Zoom Account ID</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Allowed_Host_Ids__c</fullName>
        <description>Comma-separated Zoom user IDs (host_id) whose meetings and webinars the integration accepts. Webhook events and synced sessions hosted by anyone else are ignored, so classes and internal meetings on the same Zoom account never reach Salesforce. Blank = accept every host. Find a host ID in any Zoom meeting API response (field host_id).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Comma-separated Zoom host IDs, e.g. Vj58A57CQtWF3eN4trJaQg. Blank accepts all hosts.</inlineHelpText>
        <label>Allowed Host IDs</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Client_Id__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Zoom Client ID</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Client_Secret__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Zoom Client Secret</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Create_Activities__c</fullName>
        <defaultValue>true</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Create Activities on Lead/Contact</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Webhook_Secret_Token__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Webhook Secret Token</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Zoom_User_Id__c</fullName>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Zoom User Id or Email (webinar host)</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Zoom Config</label>
    <pluralLabel>Zoom Configs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
