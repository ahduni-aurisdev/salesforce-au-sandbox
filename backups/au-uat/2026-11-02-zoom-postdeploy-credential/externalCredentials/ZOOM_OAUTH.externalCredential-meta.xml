<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Zoom Server-to-Server OAuth app. Enter ClientId and ClientSecret on the ZoomPrincipal principal after deployment; they are never stored in source.</description>
    <externalCredentialParameters>
        <parameterGroup>ZoomPrincipal</parameterGroup>
        <parameterName>ZoomPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!&apos;Basic &apos; &amp; BASE64ENCODE(BLOB($Credential.ZOOM_OAUTH.ClientId &amp; &apos;:&apos; &amp; $Credential.ZOOM_OAUTH.ClientSecret))}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Zoom OAuth</label>
</ExternalCredential>
